<!-- views/index.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campus Guard Connect — Advanced Campus Security Management</title>
    <meta name="description" content="Next-generation campus security management. Real-time GPS tracking, incident management, and intelligent guard scheduling for African universities.">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Syne + DM Sans (consistent with dashboard) -->
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">

    <style>
        /* ─── Tokens ─────────────────────────────────────── */
        :root {
            --brand-500: #4f66e5;
            --brand-600: #3b52d4;
            --brand-700: #2c3fb5;
            --brand-900: #1a2870;
            --accent:    #e14b7d;
            --success:   #12b76a;
            --bg:        #06081a;
            --surface:   #0d1130;
            --surface-2: #131840;
            --border:    rgba(255,255,255,.08);
            --text-1:    #f0f4ff;
            --text-2:    #8b9cc8;
            --text-3:    #4a5580;
            --radius-xl: 20px;
            --radius-lg: 14px;
            --radius-md: 9px;
            --ease-spring: cubic-bezier(.34,1.56,.64,1);
            --ease-out:    cubic-bezier(.22,1,.36,1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text-1);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1,h2,h3,h4,h5,h6 { font-family: 'Syne', sans-serif; letter-spacing: -.02em; }
        a { text-decoration: none; color: inherit; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--brand-600); border-radius: 99px; }

        /* ─── Keyframes ──────────────────────────────────── */
        @keyframes fadeUp   { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
        @keyframes fadeIn   { from { opacity:0; } to { opacity:1; } }
        @keyframes float    { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
        @keyframes spin     { to { transform:rotate(360deg); } }
        @keyframes glow-pulse {
            0%,100% { box-shadow: 0 0 0 0 rgba(79,102,229,.4); }
            50%      { box-shadow: 0 0 0 14px rgba(79,102,229,0); }
        }
        @keyframes shimmer {
            0%   { background-position: -600px 0; }
            100% { background-position: 600px 0; }
        }
        @keyframes count-up {
            from { opacity:0; transform:translateY(8px); }
            to   { opacity:1; transform:translateY(0); }
        }
        @keyframes scan-line {
            0%   { top: 0%; }
            100% { top: 100%; }
        }
        @keyframes orbit {
            from { transform: rotate(0deg) translateX(80px) rotate(0deg); }
            to   { transform: rotate(360deg) translateX(80px) rotate(-360deg); }
        }

        /* ─── Noise texture overlay ─────────────────────── */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 999;
        }

        /* ─── Navbar ─────────────────────────────────────── */
        .navbar {
            position: fixed; inset: 0 0 auto 0;
            background: rgba(6,8,26,.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 0 2rem;
            height: 72px;
            z-index: 1000;
            transition: background .3s, box-shadow .3s;
            animation: fadeIn .5s var(--ease-out) both;
        }

        .navbar.scrolled {
            background: rgba(6,8,26,.97);
            box-shadow: 0 8px 40px rgba(0,0,0,.4);
        }

        .navbar .container { height: 100%; display: flex; align-items: center; }

        .navbar-brand {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem; font-weight: 800;
            color: var(--text-1);
            display: flex; align-items: center; gap: .6rem;
        }

        .brand-icon {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            color: #fff; font-size: .9rem;
            box-shadow: 0 4px 16px rgba(79,102,229,.4);
        }

        .nav-link {
            font-size: .875rem; font-weight: 500;
            color: var(--text-2) !important;
            padding: .4rem .875rem !important;
            border-radius: var(--radius-md);
            transition: color .2s, background .2s;
            position: relative;
        }

        .nav-link:hover { color: var(--text-1) !important; background: rgba(255,255,255,.06); }

        .nav-link::after { display: none; }

        .btn-nav-login {
            height: 38px; padding: 0 1.25rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-md);
            background: transparent; color: var(--text-2);
            font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: .875rem;
            cursor: pointer; transition: border-color .2s, color .2s, background .2s;
            display: inline-flex; align-items: center; gap: .4rem;
        }

        .btn-nav-login:hover { border-color: var(--brand-500); color: var(--text-1); background: rgba(79,102,229,.1); }

        .btn-nav-cta {
            height: 38px; padding: 0 1.25rem;
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            border: none; border-radius: var(--radius-md);
            color: #fff; font-family: 'DM Sans', sans-serif;
            font-weight: 600; font-size: .875rem; cursor: pointer;
            box-shadow: 0 4px 16px rgba(79,102,229,.35);
            transition: transform .15s var(--ease-spring), box-shadow .2s;
            display: inline-flex; align-items: center; gap: .4rem;
        }

        .btn-nav-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(79,102,229,.5); color: #fff; }

        .navbar-toggler { border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: .4rem .6rem; }
        .navbar-toggler-icon { filter: invert(1); width: 18px; height: 18px; }

        /* ─── Hero ───────────────────────────────────────── */
        .hero {
            min-height: 100vh;
            padding: 140px 0 80px;
            position: relative;
            overflow: hidden;
            display: flex; align-items: center;
        }

        /* Background radial blobs */
        .hero::before {
            content: '';
            position: absolute;
            width: 800px; height: 800px;
            background: radial-gradient(circle, rgba(79,102,229,.2) 0%, transparent 65%);
            top: -200px; right: -200px;
            pointer-events: none;
        }

        .hero::after {
            content: '';
            position: absolute;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(225,75,125,.12) 0%, transparent 65%);
            bottom: -100px; left: -100px;
            pointer-events: none;
        }

        .hero-eyebrow {
            display: inline-flex; align-items: center; gap: .5rem;
            padding: .35rem 1rem;
            border: 1px solid rgba(79,102,229,.35);
            background: rgba(79,102,229,.1);
            border-radius: 99px;
            color: #a5b4fc;
            font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .hero-eyebrow .dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--brand-500);
            animation: glow-pulse 2s infinite;
        }

        .hero-title {
            font-size: clamp(2.5rem, 5.5vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
            color: var(--text-1);
            margin-bottom: 1.5rem;
        }

        .hero-title .accent-line {
            display: block;
            background: linear-gradient(90deg, var(--brand-500) 0%, #a5b4fc 50%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: 1.1rem; color: var(--text-2); line-height: 1.8;
            max-width: 540px; margin-bottom: 2.5rem;
        }

        .hero-actions { display: flex; gap: .875rem; flex-wrap: wrap; margin-bottom: 3rem; }

        .btn-hero-primary {
            height: 52px; padding: 0 2rem;
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            border: none; border-radius: var(--radius-lg);
            color: #fff; font-family: 'DM Sans', sans-serif;
            font-weight: 700; font-size: 1rem; cursor: pointer;
            box-shadow: 0 8px 32px rgba(79,102,229,.4);
            transition: transform .2s var(--ease-spring), box-shadow .2s;
            display: inline-flex; align-items: center; gap: .6rem;
        }

        .btn-hero-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(79,102,229,.55); color: #fff; }

        .btn-hero-ghost {
            height: 52px; padding: 0 2rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            background: transparent; color: var(--text-2);
            font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 1rem; cursor: pointer;
            transition: border-color .2s, color .2s, background .2s;
            display: inline-flex; align-items: center; gap: .6rem;
        }

        .btn-hero-ghost:hover { border-color: var(--brand-500); color: var(--text-1); background: rgba(79,102,229,.08); }

        .hero-trust {
            display: flex; align-items: center; gap: 1rem;
            font-size: .825rem; color: var(--text-3);
        }

        .trust-avatars { display: flex; }
        .trust-avatar {
            width: 32px; height: 32px; border-radius: 50%;
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            font-family: 'Syne', sans-serif; font-size: .65rem; font-weight: 700;
            color: #fff; border: 2px solid var(--bg);
            margin-left: -8px;
        }
        .trust-avatars .trust-avatar:first-child { margin-left: 0; }

        /* ── Hero Dashboard Mockup ── */
        .hero-visual {
            position: relative;
        }

        .dashboard-mockup {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: 0 40px 100px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.05);
            transform: perspective(1200px) rotateY(-8deg) rotateX(4deg);
            transition: transform .5s var(--ease-out);
            animation: fadeUp .8s var(--ease-out) .2s both;
        }

        .dashboard-mockup:hover {
            transform: perspective(1200px) rotateY(-2deg) rotateX(1deg);
        }

        .mockup-topbar {
            background: var(--surface-2);
            padding: .75rem 1rem;
            display: flex; align-items: center; gap: .5rem;
            border-bottom: 1px solid var(--border);
        }

        .mockup-dot { width: 10px; height: 10px; border-radius: 50%; }

        .mockup-body { padding: 1rem; }

        .mockup-stat-row { display: grid; grid-template-columns: repeat(4,1fr); gap: .6rem; margin-bottom: 1rem; }

        .mockup-stat {
            background: var(--surface-2);
            border-radius: var(--radius-md);
            padding: .75rem;
            border: 1px solid var(--border);
        }

        .mockup-stat-val { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text-1); }
        .mockup-stat-lbl { font-size: .65rem; color: var(--text-3); text-transform: uppercase; letter-spacing: .04em; }

        .mockup-map {
            background: var(--surface-2);
            border-radius: var(--radius-md);
            height: 120px;
            border: 1px solid var(--border);
            position: relative; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
        }

        .mockup-map-grid {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(79,102,229,.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(79,102,229,.06) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .mockup-map-scan {
            position: absolute; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, transparent, rgba(79,102,229,.6), transparent);
            animation: scan-line 3s linear infinite;
        }

        .map-dot {
            position: absolute; width: 8px; height: 8px; border-radius: 50%;
            background: var(--brand-500);
            box-shadow: 0 0 0 4px rgba(79,102,229,.25);
        }

        .map-dot-2 { background: var(--success); box-shadow: 0 0 0 4px rgba(18,183,106,.25); top: 40%; left: 60%; }
        .map-dot-3 { background: var(--accent); box-shadow: 0 0 0 4px rgba(225,75,125,.25); top: 65%; left: 30%; }
        .map-dot-1 { top: 25%; left: 45%; }

        /* Scan overlay shimmer */
        .mockup-shimmer {
            position: absolute; inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(79,102,229,.04) 50%, transparent 100%);
            background-size: 600px 100%;
            animation: shimmer 3s infinite;
        }

        /* ── Floating cards next to mockup ── */
        .float-badge {
            position: absolute;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: .875rem 1.25rem;
            display: flex; align-items: center; gap: .75rem;
            box-shadow: 0 20px 40px rgba(0,0,0,.4);
            font-size: .82rem;
            z-index: 2;
        }

        .float-badge-icon {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            display: grid; place-items: center;
            font-size: 1rem; flex-shrink: 0;
        }

        .float-badge .label { font-weight: 700; color: var(--text-1); font-size: .8rem; }
        .float-badge .sub   { font-size: .7rem; color: var(--text-3); }

        .float-badge-1 { top: 15%; left: -18%; animation: float 4s ease-in-out infinite; }
        .float-badge-2 { bottom: 18%; right: -16%; animation: float 4s ease-in-out 2s infinite; }

        /* ─── Section shared ─────────────────────────────── */
        section { padding: 100px 0; }

        .section-eyebrow {
            font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
            color: var(--brand-500); margin-bottom: .875rem;
            display: flex; align-items: center; gap: .5rem;
        }

        .section-eyebrow::before {
            content: '';
            width: 24px; height: 2px;
            background: var(--brand-500);
            border-radius: 99px;
        }

        .section-title {
            font-size: clamp(1.8rem, 3vw, 2.75rem);
            font-weight: 800; color: var(--text-1); margin-bottom: 1rem;
        }

        .section-desc { font-size: 1rem; color: var(--text-2); max-width: 600px; line-height: 1.8; }

        /* ─── Features ───────────────────────────────────── */
        .features-section { background: var(--bg); }

        .features-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(310px,1fr)); gap: 1.25rem; margin-top: 3.5rem; }

        .feature-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 2rem;
            position: relative; overflow: hidden;
            transition: transform .25s var(--ease-spring), border-color .2s, box-shadow .25s;
        }

        .feature-card::before {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(79,102,229,.06) 0%, transparent 60%);
            opacity: 0; transition: opacity .3s;
        }

        .feature-card:hover { transform: translateY(-6px); border-color: rgba(79,102,229,.35); box-shadow: 0 20px 50px rgba(0,0,0,.3); }
        .feature-card:hover::before { opacity: 1; }

        .feature-icon-wrap {
            width: 52px; height: 52px;
            border-radius: var(--radius-lg);
            background: rgba(79,102,229,.12);
            display: grid; place-items: center;
            margin-bottom: 1.25rem;
            transition: background .3s;
        }

        .feature-card:hover .feature-icon-wrap { background: var(--brand-500); }
        .feature-icon-wrap i { font-size: 1.3rem; color: var(--brand-500); transition: color .3s; }
        .feature-card:hover .feature-icon-wrap i { color: #fff; }

        .feature-title { font-size: 1.05rem; font-weight: 700; color: var(--text-1); margin-bottom: .6rem; }
        .feature-text  { font-size: .875rem; color: var(--text-2); line-height: 1.75; margin-bottom: 1.25rem; }

        .feature-link {
            font-size: .8rem; font-weight: 700;
            color: var(--brand-500);
            display: inline-flex; align-items: center; gap: .35rem;
            transition: gap .2s, color .2s;
        }

        .feature-link:hover { gap: .6rem; color: #a5b4fc; }

        /* ─── Stats Banner ───────────────────────────────── */
        .stats-banner {
            background: var(--surface);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 60px 0;
        }

        .stats-banner .stat-item { text-align: center; }

        .stat-number {
            font-family: 'Syne', sans-serif;
            font-size: clamp(2rem,4vw,3.25rem);
            font-weight: 800; color: var(--text-1);
            line-height: 1; margin-bottom: .3rem;
        }

        .stat-number .gradient-num {
            background: linear-gradient(90deg, var(--brand-500), #a5b4fc);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .stat-label-text { font-size: .78rem; font-weight: 600; color: var(--text-3); text-transform: uppercase; letter-spacing: .07em; }

        .stat-divider { width: 1px; background: var(--border); height: 50px; margin: auto; }

        /* ─── How It Works ───────────────────────────────── */
        .how-section { background: var(--bg); }

        .steps-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(260px,1fr)); gap: 2rem; margin-top: 3.5rem; }

        .step-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 2rem;
            position: relative;
            transition: transform .25s var(--ease-spring), border-color .2s;
        }

        .step-card:hover { transform: translateY(-5px); border-color: rgba(79,102,229,.35); }

        .step-num {
            width: 48px; height: 48px;
            border-radius: var(--radius-lg);
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.1rem; color: #fff;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 24px rgba(79,102,229,.35);
            animation: glow-pulse 3s infinite;
        }

        .step-card:nth-child(2) .step-num { animation-delay: 1s; }
        .step-card:nth-child(3) .step-num { animation-delay: 2s; }

        .step-title { font-size: 1.05rem; font-weight: 700; color: var(--text-1); margin-bottom: .6rem; }
        .step-desc  { font-size: .875rem; color: var(--text-2); line-height: 1.75; }

        /* Connector line desktop */
        @media (min-width:992px) {
            .steps-grid { position: relative; }
            .steps-grid::before {
                content: '';
                position: absolute;
                top: 40px; left: calc(33% - 10px); right: calc(33% - 10px);
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--border), var(--brand-500), var(--border), transparent);
                pointer-events: none;
            }
        }

        /* ─── Testimonials ───────────────────────────────── */
        .testimonials-section { background: var(--surface); }

        .testimonial-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(300px,1fr)); gap: 1.25rem; margin-top: 3.5rem; }

        .testimonial-card {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 2rem;
            transition: transform .25s var(--ease-spring), border-color .2s, box-shadow .25s;
            position: relative;
        }

        .testimonial-card::before {
            content: '\201C';
            position: absolute; top: 1.25rem; right: 1.75rem;
            font-family: 'Syne', sans-serif; font-size: 5rem; line-height: 1;
            color: rgba(79,102,229,.1);
        }

        .testimonial-card:hover { transform: translateY(-5px); border-color: rgba(79,102,229,.3); box-shadow: 0 20px 50px rgba(0,0,0,.3); }

        .stars { color: #fbbf24; font-size: .875rem; margin-bottom: 1.25rem; letter-spacing: .1em; }

        .testimonial-text { font-size: .9rem; color: var(--text-2); line-height: 1.85; margin-bottom: 1.5rem; font-style: italic; }

        .testimonial-author { display: flex; align-items: center; gap: .875rem; }

        .t-avatar {
            width: 44px; height: 44px; border-radius: 50%;
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            font-family: 'Syne', sans-serif; font-size: .85rem; font-weight: 700; color: #fff;
            flex-shrink: 0;
        }

        .t-name { font-size: .9rem; font-weight: 700; color: var(--text-1); margin-bottom: 2px; }
        .t-role { font-size: .75rem; color: var(--text-3); }

        /* ─── CTA ────────────────────────────────────────── */
        .cta-section {
            background: var(--bg);
            padding: 100px 0;
        }

        .cta-box {
            background: linear-gradient(135deg, var(--surface) 0%, var(--surface-2) 100%);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 5rem 3rem;
            text-align: center;
            position: relative; overflow: hidden;
        }

        .cta-box::before {
            content: '';
            position: absolute;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(79,102,229,.15) 0%, transparent 65%);
            top: -200px; left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .cta-title {
            font-size: clamp(1.8rem,3vw,2.75rem);
            font-weight: 800; color: var(--text-1); margin-bottom: 1rem;
        }

