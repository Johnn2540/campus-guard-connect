    <!-- Crop Image Modal -->
    <div class="modal fade" id="cropImageModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-crop me-2"></i>
                        Crop Profile Picture
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="crop-container">
                        <img id="cropImage" src="" style="max-width: 100%;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-primary" onclick="cropAndUpload()">Save Picture</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    
    <script>
        // Tab switching
        function switchTab(tabId) {
            document.querySelectorAll('.profile-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            document.querySelectorAll('.tab-panel').forEach(panel => {
                panel.classList.remove('active');
            });
            document.getElementById(`tab-${tabId}`).classList.add('active');
        }

        // Save all changes
        function saveAllChanges() {
            // Collect personal info
            const personalForm = document.getElementById('personalInfoForm');
            const formData = new FormData(personalForm);
            
            const personalData = {
                firstName: formData.get('firstName'),
                lastName: formData.get('lastName'),
                phoneNumber: formData.get('phoneNumber'),
                institution: formData.get('institution'),
                timezone: formData.get('timezone'),
                emergencyContact: {
                    name: formData.get('emergencyName'),
                    relationship: formData.get('emergencyRelationship'),
                    phone: formData.get('emergencyPhone')
                }
            };

            // Add shift preferences for guards
            {{#if (eq profileUser.role "guard")}}
            personalData.shiftPreferences = {
                preferredShifts: [
                    formData.get('shiftMorning'),
                    formData.get('shiftAfternoon'),
                    formData.get('shiftNight')
                ].filter(Boolean),
                maxHoursPerWeek: formData.get('maxHours')
            };
            {{/if}}

            fetch('/api/profile/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(personalData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Profile updated successfully', 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast('Failed to update profile', 'error');
                }
            });
        }

        // Avatar upload
        document.getElementById('avatarUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('cropImage').src = e.target.result;
                    new bootstrap.Modal(document.getElementById('cropImageModal')).show();
                    
                    // Initialize cropper after modal is shown
                    setTimeout(() => {
                        const image = document.getElementById('cropImage');
                        const cropper = new Cropper(image, {
                            aspectRatio: 1,
                            viewMode: 1,
                            dragMode: 'move',
                            autoCropArea: 1,
                            cropBoxResizable: true,
                            cropBoxMovable: true
                        });
                        window.cropper = cropper;
                    }, 500);
                };
                reader.readAsDataURL(file);
            }
        });

        // Crop and upload
        function cropAndUpload() {
            if (window.cropper) {
                const canvas = window.cropper.getCroppedCanvas({
                    width: 300,
                    height: 300
                });
                
                canvas.toBlob(function(blob) {
                    const formData = new FormData();
                    formData.append('avatar', blob, 'avatar.jpg');
                    
                    fetch('/api/profile/avatar', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Profile picture updated', 'success');
                            setTimeout(() => window.location.reload(), 1500);
                        }
                    });
                }, 'image/jpeg');
                
                bootstrap.Modal.getInstance(document.getElementById('cropImageModal')).hide();
            }
        }

        // Change password
        function changePassword() {
            new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
        }

        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = {
                currentPassword: formData.get('currentPassword'),
                newPassword: formData.get('newPassword'),
                confirmPassword: formData.get('confirmPassword')
            };

            if (data.newPassword !== data.confirmPassword) {
                showToast('New passwords do not match', 'error');
                return;
            }

            fetch('/api/profile/password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Password updated successfully', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                } else {
                    showToast(data.message || 'Failed to update password', 'error');
                }
            });
        });

        // Toggle two-factor
        function toggleTwoFactor() {
            fetch('/api/profile/2fa/toggle', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                }
            });
        }

        // Toggle setting
        function toggleSetting(setting) {
            fetch(`/api/profile/settings/${setting}/toggle`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const toggle = event.currentTarget;
                    toggle.classList.toggle('active');
                }
            });
        }

        // Toggle notification
        function toggleNotification(type) {
            fetch(`/api/profile/notifications/${type}/toggle`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const toggle = event.currentTarget;
                    toggle.classList.toggle('active');
                }
            });
        }

        // Toggle alert type
        function toggleAlertType(type) {
            fetch(`/api/profile/alerts/${type}/toggle`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const toggle = event.currentTarget;
                    toggle.classList.toggle('active');
                }
            });
        }

        // Logout all devices
        function logoutAllDevices() {
            if (confirm('This will log you out from all other devices. Continue?')) {
                fetch('/api/profile/logout-all', {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast('Logged out from all other devices', 'success');
                    }
                });
            }
        }

        // Logout specific device
        function logoutDevice(deviceId) {
            fetch(`/api/profile/devices/${deviceId}/logout`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                }
            });
        }

        // Toast notification
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                    <div>${message}</div>
                </div>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Helper function to check if array includes value
        Handlebars.registerHelper('includes', function(array, value) {
            return array && array.includes(value);
        });
    </script>
</body>
</html>