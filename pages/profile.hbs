                        <div class="profile-stat-value">{{stats.patrols}}</div>
                        <div class="profile-stat-label">Patrols</div>
                    </div>
                    <div class="profile-stat">
                        <div class="profile-stat-value">{{stats.incidents}}</div>
                        <div class="profile-stat-label">Incidents</div>
                    </div>
                </div>
                
                <div class="profile-info">
                    <div class="profile-info-item">
                        <div class="profile-info-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="profile-info-content">
                            <div class="profile-info-label">Email</div>
                            <div class="profile-info-value">{{profileUser.email}}</div>
                        </div>
                    </div>
                    
                    <div class="profile-info-item">
                        <div class="profile-info-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="profile-info-content">
                            <div class="profile-info-label">Phone</div>
                            <div class="profile-info-value">{{profileUser.phoneNumber}}</div>
                        </div>
                    </div>
                    
