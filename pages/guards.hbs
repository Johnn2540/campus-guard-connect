<!-- views/guards.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guard Management - Campus Guard Connect</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --brand-50:  #f0f3ff;
            --brand-100: #e0e7ff;
            --brand-400: #7c8fe8;
            --brand-500: #4f66e5;
            --brand-600: #3b52d4;
            --brand-700: #2c3fb5;
            --success:   #12b76a;
            --warning:   #f59e0b;
            --danger:    #ef4444;
            --bg:        #f4f6fb;
            --surface:   #ffffff;
            --border:    rgba(0,0,0,.07);
            --text-1:    #0f172a;
            --text-2:    #475569;
            --text-3:    #94a3b8;
            --nav-h:     72px;
            --radius-xl: 18px;
            --radius-lg: 12px;
            --radius-md: 8px;
            --shadow-sm: 0 1px 4px rgba(0,0,0,.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,.08);
            --shadow-lg: 0 12px 40px rgba(79,102,229,.18);
            --ease-spring: cubic-bezier(.34,1.56,.64,1);
            --ease-out:    cubic-bezier(.22,1,.36,1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body { font-family: 'DM Sans', sans-serif; font-size: 15px; background: var(--bg); color: var(--text-1); -webkit-font-smoothing: antialiased; }
        h1,h2,h3,h4,h5,h6 { font-family: 'Syne', sans-serif; letter-spacing: -.02em; }
        a { text-decoration: none; color: inherit; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--brand-100); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--brand-400); }

        @keyframes fadeUp   { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
        @keyframes fadeIn   { from { opacity:0; } to { opacity:1; } }
        @keyframes badge-pop { 0%{transform:scale(0)} 70%{transform:scale(1.15)} 100%{transform:scale(1)} }
        @keyframes spin     { to { transform:rotate(360deg); } }
        @keyframes pulse-dot {
            0%,100% { box-shadow:0 0 0 0 rgba(18,183,106,.5); }
            50%      { box-shadow:0 0 0 6px rgba(18,183,106,0); }
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; height: var(--nav-h);
            background: var(--surface); border-bottom: 1px solid var(--border);
            z-index: 1030; padding: 0 1.5rem;
            display: flex; align-items: center; gap: 1rem;
            animation: fadeIn .4s var(--ease-out) both;
        }
        .navbar-brand { font-family:'Syne',sans-serif; font-size:1.2rem; font-weight:800; color:var(--brand-500); display:flex; align-items:center; gap:.6rem; white-space:nowrap; flex-shrink:0; }
        .brand-icon { width:36px; height:36px; border-radius:var(--radius-md); background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); display:grid; place-items:center; color:#fff; font-size:.9rem; box-shadow:0 4px 12px rgba(79,102,229,.35); flex-shrink:0; }
        .nav-right { margin-left:auto; display:flex; align-items:center; gap:.75rem; }
        .nav-icon-btn { width:40px; height:40px; border:1.5px solid var(--border); border-radius:var(--radius-md); background:var(--surface); display:grid; place-items:center; color:var(--text-2); cursor:pointer; position:relative; transition:border-color .2s,color .2s,transform .15s var(--ease-spring); }
        .nav-icon-btn:hover { border-color:var(--brand-400); color:var(--brand-500); transform:translateY(-1px); }
        .nav-icon-btn .badge-count { position:absolute; top:-6px; right:-6px; background:var(--danger); color:#fff; font-size:.65rem; font-weight:700; min-width:18px; height:18px; border-radius:99px; display:grid; place-items:center; padding:0 4px; border:2px solid var(--surface); animation:badge-pop .4s var(--ease-spring) both; }
        .user-chip { display:flex; align-items:center; gap:.6rem; padding:.3rem .5rem .3rem .3rem; border:1.5px solid var(--border); border-radius:var(--radius-lg); cursor:pointer; transition:border-color .2s,background .2s; }
        .user-chip:hover { border-color:var(--brand-400); background:var(--brand-50); }
        .user-avatar { width:34px; height:34px; border-radius:var(--radius-md); background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); display:grid; place-items:center; color:#fff; font-family:'Syne',sans-serif; font-size:.8rem; font-weight:700; flex-shrink:0; }
        .user-chip-info { display:none; }
        @media (min-width:768px) {
            .user-chip-info { display:block; }
            .user-chip-info .name { font-family:'Syne',sans-serif; font-size:.8rem; font-weight:700; color:var(--text-1); line-height:1.2; }
            .user-chip-info .role { font-size:.72rem; color:var(--text-3); text-transform:capitalize; }
        }
        .dropdown-menu { border:1.5px solid var(--border) !important; border-radius:var(--radius-lg) !important; box-shadow:var(--shadow-md) !important; padding:.4rem !important; font-size:.875rem; animation:fadeUp .2s var(--ease-out) both; }
        .dropdown-item { border-radius:var(--radius-md); padding:.55rem .85rem; color:var(--text-2); font-weight:500; transition:background .15s,color .15s; }
        .dropdown-item:hover { background:var(--brand-50); color:var(--brand-600); }
        .dropdown-item.text-danger:hover { background:#fff1f1; color:var(--danger); }
        .dropdown-divider { border-color:var(--border); margin:.3rem 0; }

        /* ── Main Content ── */
        .main-content { max-width:1400px; margin:0 auto; padding:1.75rem; }
        .main-content > * { animation:fadeUp .4s var(--ease-out) both; }
        .main-content > *:nth-child(1) { animation-delay:.06s; }
        .main-content > *:nth-child(2) { animation-delay:.12s; }
        .main-content > *:nth-child(3) { animation-delay:.18s; }
        .main-content > *:nth-child(4) { animation-delay:.24s; }
        .main-content > *:nth-child(5) { animation-delay:.30s; }

        /* ── Page Header ── */
        .page-header { display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.75rem; }
        .page-header h2 { font-size:clamp(1.5rem,2.5vw,2rem); font-weight:800; color:var(--text-1); margin-bottom:.25rem; }
        .page-header p { color:var(--text-3); margin:0; font-size:.9rem; }
        .header-actions { display:flex; gap:.75rem; align-items:center; flex-shrink:0; }

        /* ── Stat Cards ── */
        .stats-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1rem; margin-bottom:1.5rem; }
        .stat-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.4rem; position:relative; overflow:hidden; transition:transform .2s var(--ease-spring),box-shadow .2s; }
        .stat-card:nth-child(1) { animation:fadeUp .4s var(--ease-out) .08s both; }
        .stat-card:nth-child(2) { animation:fadeUp .4s var(--ease-out) .14s both; }
        .stat-card:nth-child(3) { animation:fadeUp .4s var(--ease-out) .20s both; }
        .stat-card:nth-child(4) { animation:fadeUp .4s var(--ease-out) .26s both; }
        .stat-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-lg); }
        .stat-card::after { content:''; position:absolute; bottom:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--brand-500),var(--brand-700)); transform:scaleX(0); transform-origin:left; transition:transform .3s var(--ease-out); }
        .stat-card:hover::after { transform:scaleX(1); }
        .stat-icon { width:48px; height:48px; border-radius:var(--radius-lg); background:var(--brand-50); display:grid; place-items:center; margin-bottom:.875rem; }
        .stat-icon i { font-size:1.3rem; color:var(--brand-500); }
        .stat-value { font-family:'Syne',sans-serif; font-size:1.875rem; font-weight:800; color:var(--text-1); line-height:1; margin-bottom:.25rem; }
        .stat-label { font-size:.78rem; font-weight:500; color:var(--text-3); text-transform:uppercase; letter-spacing:.04em; }
        .stat-meta { font-size:.78rem; color:var(--text-3); margin-top:.3rem; }
        .stat-trend { font-size:.78rem; font-weight:600; display:flex; align-items:center; gap:.25rem; margin-top:.4rem; }
        .trend-up { color:var(--success); }

        /* ── Filter Bar ── */
        .filter-bar { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.25rem 1.5rem; margin-bottom:1.5rem; display:flex; flex-wrap:wrap; gap:.875rem; align-items:flex-end; }
        .filter-group { flex:1; min-width:140px; }
        .filter-group label { font-size:.72rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--text-3); margin-bottom:.35rem; display:block; }
        .filter-select, .filter-input { width:100%; height:40px; padding:0 .875rem; border:1.5px solid var(--border); border-radius:var(--radius-md); font-family:'DM Sans',sans-serif; font-size:.875rem; background:var(--bg); color:var(--text-1); transition:border-color .2s,box-shadow .2s; }
        .filter-select:focus, .filter-input:focus { outline:none; border-color:var(--brand-400); box-shadow:0 0 0 4px rgba(79,102,229,.12); background:var(--surface); }
        .filter-input::placeholder { color:var(--text-3); }
        .filter-actions { display:flex; gap:.5rem; align-items:center; }
        .btn-filter { height:40px; padding:0 1.25rem; background:var(--brand-500); color:#fff; border:none; border-radius:var(--radius-md); font-family:'DM Sans',sans-serif; font-weight:600; font-size:.875rem; cursor:pointer; display:inline-flex; align-items:center; gap:.4rem; transition:background .2s,transform .15s var(--ease-spring); }
        .btn-filter:hover { background:var(--brand-700); transform:translateY(-1px); }
        .btn-reset { height:40px; padding:0 1.25rem; background:var(--bg); color:var(--text-2); border:1.5px solid var(--border); border-radius:var(--radius-md); font-family:'DM Sans',sans-serif; font-weight:600; font-size:.875rem; cursor:pointer; display:inline-flex; align-items:center; gap:.4rem; transition:background .2s; }
        .btn-reset:hover { background:#e2e8f0; }

        /* ── Table Container ── */
        .table-container { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); overflow:hidden; margin-bottom:1.5rem; }
        .table-toolbar { display:flex; justify-content:space-between; align-items:center; padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:.75rem; }
        .table-toolbar h5 { font-size:.95rem; font-weight:700; color:var(--text-1); margin:0; display:flex; align-items:center; gap:.5rem; }
        .table-toolbar h5 i { color:var(--brand-500); font-size:.9rem; }

        /* ── DataTable overrides ── */
        #guardsTable_wrapper .dataTables_length,
        #guardsTable_wrapper .dataTables_filter { padding:1rem 1.5rem .5rem; }
        #guardsTable_wrapper .dataTables_length select,
        #guardsTable_wrapper .dataTables_filter input { border:1.5px solid var(--border) !important; border-radius:var(--radius-md) !important; font-family:'DM Sans',sans-serif !important; font-size:.875rem !important; height:38px; padding:0 .75rem !important; background:var(--bg) !important; color:var(--text-1) !important; transition:border-color .2s,box-shadow .2s; }
        #guardsTable_wrapper .dataTables_filter input:focus { outline:none !important; border-color:var(--brand-400) !important; box-shadow:0 0 0 4px rgba(79,102,229,.12) !important; }
        #guardsTable_wrapper .dataTables_info,
        #guardsTable_wrapper .dataTables_paginate { padding:.75rem 1.5rem 1rem; }
        #guardsTable_wrapper .page-link { border-radius:var(--radius-md) !important; border:1.5px solid var(--border) !important; color:var(--text-2) !important; font-size:.8rem !important; font-weight:600 !important; transition:all .15s; }
        #guardsTable_wrapper .page-link:hover { background:var(--brand-50) !important; color:var(--brand-600) !important; border-color:var(--brand-400) !important; }
        #guardsTable_wrapper .page-item.active .page-link { background:var(--brand-500) !important; border-color:var(--brand-500) !important; color:#fff !important; }

        table.dataTable thead th, table.dataTable thead td { font-family:'DM Sans',sans-serif !important; font-size:.72rem !important; font-weight:700 !important; letter-spacing:.06em !important; text-transform:uppercase !important; color:var(--text-3) !important; padding:.875rem 1rem !important; border-bottom:1px solid var(--border) !important; background:var(--bg) !important; }
        table.dataTable tbody td { padding:.875rem 1rem !important; vertical-align:middle !important; border-bottom:1px solid var(--border) !important; font-size:.875rem !important; }
        table.dataTable tbody tr { transition:background .15s; }
        table.dataTable tbody tr:hover td { background:var(--brand-50) !important; }
        table.dataTable tbody tr:last-child td { border-bottom:none !important; }

        /* ── Guard Info Cell ── */
        .guard-info { display:flex; align-items:center; gap:.875rem; }
        .guard-avatar { width:40px; height:40px; border-radius:var(--radius-md); background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); display:grid; place-items:center; color:#fff; font-family:'Syne',sans-serif; font-size:.78rem; font-weight:700; flex-shrink:0; }
        .guard-details h6 { font-size:.875rem; font-weight:600; margin-bottom:2px; color:var(--text-1); }
        .guard-details small { font-size:.75rem; color:var(--text-3); }

        /* ── Badges ── */
        .badge-role { padding:.25rem .65rem; border-radius:99px; font-size:.72rem; font-weight:700; letter-spacing:.02em; display:inline-block; }
        .role-admin      { background:rgba(79,102,229,.12); color:var(--brand-700); }
        .role-supervisor { background:rgba(245,158,11,.12); color:#92400e; }
        .role-guard      { background:rgba(18,183,106,.12); color:#065f46; }

        .status-badge { padding:.25rem .65rem; border-radius:99px; font-size:.72rem; font-weight:700; display:inline-flex; align-items:center; gap:.3rem; }
        .status-badge::before { content:''; width:6px; height:6px; border-radius:50%; display:block; flex-shrink:0; }
        .status-online   { background:rgba(18,183,106,.12); color:#065f46; }
        .status-online::before { background:var(--success); animation:pulse-dot 2.5s infinite; }
        .status-active   { background:rgba(18,183,106,.08); color:#065f46; }
        .status-active::before { background:var(--success); opacity:.5; }
        .status-inactive { background:rgba(239,68,68,.1); color:#991b1b; }
        .status-inactive::before { background:var(--danger); }
        .status-on-leave { background:rgba(245,158,11,.12); color:#92400e; }
        .status-on-leave::before { background:var(--warning); }

        .badge-zone { padding:.25rem .65rem; border-radius:99px; font-size:.72rem; font-weight:600; background:var(--brand-50); color:var(--brand-600); border:1px solid var(--brand-100); }

        /* ── Action Buttons ── */
        .action-btns { display:flex; gap:.35rem; }
        .action-btn { width:32px; height:32px; border:none; background:transparent; border-radius:var(--radius-md); color:var(--text-3); cursor:pointer; display:grid; place-items:center; font-size:.85rem; transition:background .15s,color .15s,transform .15s var(--ease-spring); }
        .action-btn:hover { transform:translateY(-2px); }
        .view-btn:hover  { background:rgba(59,130,246,.1);  color:#2563eb; }
        .edit-btn:hover  { background:rgba(18,183,106,.1);  color:#065f46; }
        .shift-btn:hover { background:rgba(139,92,246,.1);  color:#6d28d9; }
        .delete-btn:hover{ background:rgba(239,68,68,.1);   color:#991b1b; }

        /* ── Buttons ── */
        .btn-brand { background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); border:none; color:#fff; font-family:'DM Sans',sans-serif; font-weight:600; border-radius:var(--radius-md); padding:.6rem 1.25rem; display:inline-flex; align-items:center; gap:.5rem; font-size:.875rem; cursor:pointer; transition:transform .15s var(--ease-spring),box-shadow .15s; }
        .btn-brand:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(79,102,229,.35); color:#fff; }
        .btn-outline-brand { border:1.5px solid var(--border); background:var(--surface); font-family:'DM Sans',sans-serif; font-weight:600; border-radius:var(--radius-md); padding:.6rem 1.25rem; display:inline-flex; align-items:center; gap:.5rem; font-size:.875rem; color:var(--text-2); cursor:pointer; transition:border-color .2s,color .2s,background .2s,transform .15s var(--ease-spring); }
        .btn-outline-brand:hover { border-color:var(--brand-400); color:var(--brand-600); background:var(--brand-50); transform:translateY(-1px); }

        /* ── Chart Cards ── */
        .chart-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); padding:1.5rem; height:100%; transition:box-shadow .2s; }
        .chart-card:hover { box-shadow:var(--shadow-md); }
        .chart-card h5 { font-size:.95rem; font-weight:700; color:var(--text-1); margin-bottom:1.25rem; display:flex; align-items:center; gap:.5rem; }
        .chart-card h5 i { color:var(--brand-500); font-size:.9rem; }

        /* ── Modal ── */
        .modal-content { border:none !important; border-radius:var(--radius-xl) !important; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.15) !important; }
        .modal-header { background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); color:#fff; padding:1.25rem 1.5rem; border:none; }
        .modal-header .modal-title { font-family:'Syne',sans-serif; font-size:1rem; font-weight:700; display:flex; align-items:center; gap:.5rem; }
        .modal-header .btn-close { filter:brightness(0) invert(1); opacity:.8; }
        .modal-body { padding:1.75rem; }
        .modal-footer { padding:1.25rem 1.5rem; border-top:1px solid var(--border); background:var(--bg); }

        .form-label { font-family:'DM Sans',sans-serif; font-size:.78rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--text-2); margin-bottom:.4rem; display:flex; align-items:center; gap:.35rem; }
        .form-label i { color:var(--brand-500); font-size:.85rem; }
        .form-control, .form-select { height:44px; border:1.5px solid var(--border); border-radius:var(--radius-md); padding:0 .875rem; font-family:'DM Sans',sans-serif; font-size:.9rem; color:var(--text-1); background:var(--bg); transition:border-color .2s,box-shadow .2s,background .2s; }
        textarea.form-control { height:auto; padding:.75rem .875rem; }
        .form-control:focus, .form-select:focus { outline:none; border-color:var(--brand-400); box-shadow:0 0 0 4px rgba(79,102,229,.12); background:var(--surface); }
        .form-control[readonly] { background:var(--bg); color:var(--text-2); cursor:default; }
        .form-text { font-size:.75rem; color:var(--text-3); }
        .form-check-input:checked { background-color:var(--brand-500); border-color:var(--brand-500); }
        .form-check-label { font-size:.875rem; color:var(--text-2); font-weight:500; }

        /* ── Guard Detail Modal ── */
        .guard-hero { text-align:center; padding:1.5rem 1rem; border-bottom:1px solid var(--border); margin-bottom:1.25rem; }
        .guard-hero-avatar { width:72px; height:72px; border-radius:var(--radius-lg); background:linear-gradient(135deg,var(--brand-500),var(--brand-700)); display:grid; place-items:center; color:#fff; font-family:'Syne',sans-serif; font-size:1.5rem; font-weight:700; margin:0 auto 1rem; }
        .guard-hero h4 { font-size:1.1rem; font-weight:700; margin-bottom:.35rem; }

        .detail-group { margin-bottom:1rem; }
        .detail-label { font-size:.72rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--text-3); margin-bottom:.3rem; }
        .detail-value { background:var(--bg); border-radius:var(--radius-md); padding:.55rem .875rem; font-size:.875rem; color:var(--text-1); display:flex; align-items:center; gap:.5rem; }
        .detail-value i { color:var(--text-3); font-size:.85rem; flex-shrink:0; }

        /* ── Empty state ── */
        .empty-state { text-align:center; padding:3rem 1rem; color:var(--text-3); }
        .empty-state i { font-size:2.5rem; display:block; margin-bottom:.75rem; opacity:.3; }

        /* ── Shift badge in assign modal ── */
        .shift-option { display:flex; align-items:center; gap:.5rem; padding:.6rem .875rem; border:1.5px solid var(--border); border-radius:var(--radius-md); cursor:pointer; transition:border-color .2s,background .2s; margin-bottom:.5rem; }
        .shift-option:hover { border-color:var(--brand-400); background:var(--brand-50); }
        .shift-option input[type="radio"] { accent-color:var(--brand-500); }

        /* ── Responsive ── */
        @media (max-width:768px) {
            .main-content { padding:1rem; }
            .stats-row { grid-template-columns:1fr 1fr; }
            .filter-bar { flex-direction:column; }
            .filter-group { width:100%; }
            .page-header { flex-direction:column; }
            table.dataTable { display:block; overflow-x:auto; }
        }

        @media (prefers-color-scheme: dark) {
            :root { --bg:#0d1117; --surface:#161b22; --border:rgba(255,255,255,.08); --text-1:#f0f6fc; --text-2:#8b949e; --text-3:#484f58; }
            .stat-icon { background:rgba(79,102,229,.15); }
            .filter-select, .filter-input, .form-control, .form-select { background:var(--bg); color:var(--text-1); }
            table.dataTable tbody tr:hover td { background:rgba(79,102,229,.06) !important; }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <a class="navbar-brand" href="/dashboard">
            <span class="brand-icon"><i class="fas fa-shield-alt"></i></span>
            CampusGuard Connect
        </a>
        <div class="nav-right">
            <div class="nav-icon-btn" role="button" aria-label="Notifications">
                <i class="far fa-bell"></i>
                <span class="badge-count">{{notificationCount}}</span>
            </div>
            <div class="dropdown">
                <div class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">{{#if user}}{{user.initials}}{{else}}U{{/if}}</div>
                    <div class="user-chip-info">
                        <div class="name">{{user.name}}</div>
                        <div class="role">{{user.role}}</div>
                    </div>
                    <i class="fas fa-chevron-down ms-1" style="font-size:.7rem;color:var(--text-3);"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end mt-1">
                    <li><a class="dropdown-item" href="/profile"><i class="fas fa-user fa-fw me-2"></i>Profile</a></li>
                    <li><a class="dropdown-item" href="/settings"><i class="fas fa-cog fa-fw me-2"></i>Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-sign-out-alt fa-fw me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h2><i class="fas fa-user-shield me-2" style="color:var(--brand-500);font-size:1.5rem;"></i>Guard Management</h2>
                <p>Manage security personnel, assignments, and performance</p>
            </div>
            <div class="header-actions">
                <button class="btn-brand" data-bs-toggle="modal" data-bs-target="#addGuardModal">
                    <i class="fas fa-user-plus"></i>Add New Guard
                </button>
                <button class="btn-outline-brand" onclick="exportGuards()">
                    <i class="fas fa-download"></i>Export
                </button>
            </div>
        </div>

        <!-- Stat Cards -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-user-shield"></i></div>
                <div class="stat-value">{{stats.totalGuards}}</div>
                <div class="stat-label">Total Guards</div>
                <div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i>{{stats.newThisMonth}} this month</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                <div class="stat-value">{{stats.activeGuards}}</div>
                <div class="stat-label">Active Guards</div>
                <div class="stat-meta">{{stats.onDuty}} currently on duty</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-umbrella-beach"></i></div>
                <div class="stat-value">{{stats.onLeave}}</div>
                <div class="stat-label">On Leave</div>
                <div class="stat-meta">Scheduled absences</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                <div class="stat-value">{{stats.attendance}}%</div>
                <div class="stat-label">Attendance Rate</div>
                <div class="stat-meta">Last 30 days</div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="filter-group">
                <label>Status</label>
                <select class="filter-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="onDuty">On Duty</option>
                    <option value="offDuty">Off Duty</option>
                    <option value="onLeave">On Leave</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Role</label>
                <select class="filter-select" id="roleFilter">
                    <option value="">All Roles</option>
                    <option value="guard">Guard</option>
                    <option value="supervisor">Supervisor</option>
                    <option value="admin">Admin</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Zone</label>
                <select class="filter-select" id="zoneFilter">
                    <option value="">All Zones</option>
                    <option value="main_gate">Main Gate</option>
                    <option value="hostels">Hostels</option>
                    <option value="academic">Academic</option>
                    <option value="perimeter">Perimeter</option>
                    <option value="parking">Parking</option>
                    <option value="admin">Admin</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Search</label>
                <input type="text" class="filter-input" id="searchInput" placeholder="Name, badge, email…">
            </div>
            <div class="filter-actions">
                <button class="btn-filter" onclick="applyFilters()"><i class="fas fa-filter"></i>Apply</button>
                <button class="btn-reset" onclick="resetFilters()"><i class="fas fa-undo"></i>Reset</button>
            </div>
        </div>

        <!-- Guards Table -->
        <div class="table-container">
            <div class="table-toolbar">
                <h5><i class="fas fa-list"></i>Security Personnel</h5>
                <div style="font-size:.8rem;color:var(--text-3);">
                    <span class="me-3"><i class="fas fa-circle" style="color:var(--success);font-size:.5rem;vertical-align:middle;"></i> {{stats.onDuty}} On Duty</span>
                    <span><i class="fas fa-circle" style="color:var(--text-3);font-size:.5rem;vertical-align:middle;"></i> {{stats.offDuty}} Off Duty</span>
                </div>
            </div>

            <table class="table mb-0" id="guardsTable" style="width:100%">
                <thead>
                    <tr>
                        <th>Guard</th>
                        <th>Badge</th>
                        <th>Role</th>
                        <th>Contact</th>
                        <th>Status</th>
                        <th>Zone</th>
                        <th>Shift</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each guards}}
                    <tr>
                        <td>
                            <div class="guard-info">
                                <div class="guard-avatar">{{initials}}</div>
                                <div class="guard-details">
                                    <h6>{{name}}</h6>
                                    <small>Joined {{formatDate createdAt "MMM YYYY"}}</small>
                                </div>
                            </div>
                        </td>
                        <td><span style="font-family:'Syne',sans-serif;font-size:.8rem;font-weight:700;">{{badgeNumber}}</span></td>
                        <td><span class="badge-role role-{{role}}">{{formatRole role}}</span></td>
                        <td>
                            <div style="font-size:.875rem;"><i class="fas fa-envelope me-1" style="color:var(--text-3);"></i>{{email}}</div>
                            <small style="color:var(--text-3);"><i class="fas fa-phone me-1"></i>{{phoneNumber}}</small>
                        </td>
                        <td>
                            {{#if isActive}}
                                {{#if isOnline}}
                                    <span class="status-badge status-online">Online</span>
                                {{else}}
                                    <span class="status-badge status-active">Active</span>
                                {{/if}}
                            {{else}}
                                <span class="status-badge status-inactive">Inactive</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if currentZone}}
                                <span class="badge-zone">{{formatZone currentZone}}</span>
                            {{else}}
                                <span style="color:var(--text-3);font-size:.8rem;">—</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if currentShift}}
                                <div style="font-size:.875rem;font-weight:600;">{{currentShift.start}}–{{currentShift.end}}</div>
                                <small style="color:var(--text-3);">{{formatDate currentShift.date}}</small>
                            {{else}}
                                <span style="color:var(--text-3);font-size:.8rem;">No shift today</span>
                            {{/if}}
                        </td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn view-btn"  onclick="viewGuard('{{_id}}')"   title="View Details"><i class="fas fa-eye"></i></button>
                                <button class="action-btn edit-btn"  onclick="editGuard('{{_id}}')"   title="Edit Guard"><i class="fas fa-edit"></i></button>
                                <button class="action-btn shift-btn" onclick="assignShift('{{_id}}')" title="Assign Shift"><i class="fas fa-calendar-plus"></i></button>
                                <button class="action-btn delete-btn" onclick="deleteGuard('{{_id}}')" title="Delete Guard"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fas fa-user-shield"></i>
                                <h5 style="font-size:1rem;color:var(--text-2);">No guards found</h5>
                                <p style="font-size:.875rem;">Click "Add New Guard" to get started</p>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <!-- Charts Row -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="chart-card">
                    <h5><i class="fas fa-chart-pie"></i>Guard Distribution by Zone</h5>
                    <canvas id="zoneChart" height="250"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <div class="chart-card">
                    <h5><i class="fas fa-chart-line"></i>Patrol Performance (This Week)</h5>
                    <canvas id="performanceChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Add Guard Modal ── -->
    <div class="modal fade" id="addGuardModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-plus"></i>Add New Guard</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="addGuardForm" method="POST" action="/guards/add">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-user"></i>First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="firstName" placeholder="e.g. John" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-user"></i>Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="lastName" placeholder="e.g. Doe" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-envelope"></i>Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" name="email" placeholder="guard@campus.ac.ke" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-phone"></i>Phone <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" name="phoneNumber" placeholder="+254 7XX XXX XXX" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-id-card"></i>Badge Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="badgeNumber" placeholder="GC-{{year}}-XXX" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-tag"></i>Role <span class="text-danger">*</span></label>
                                <select class="form-select" name="role" required>
                                    <option value="guard">Security Guard</option>
                                    <option value="supervisor">Supervisor</option>
                                    <option value="admin">Administrator</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label"><i class="fas fa-map-marker-alt"></i>Assigned Zones</label>
                                <select class="form-select" name="zones" multiple style="height:auto;padding:.5rem .875rem;">
                                    <option value="main_gate">Main Gate</option>
                                    <option value="hostels">Hostels</option>
                                    <option value="academic">Academic Area</option>
                                    <option value="perimeter">Perimeter</option>
                                    <option value="parking">Parking Lots</option>
                                    <option value="admin">Admin Block</option>
                                </select>
                                <div class="form-text">Hold Ctrl / Cmd to select multiple zones</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label"><i class="fas fa-clock"></i>Shift Preferences</label>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="shift-option">
                                            <input type="checkbox" name="shiftMorning" value="morning">
                                            <span>
                                                <strong style="font-size:.875rem;">Morning</strong><br>
                                                <span style="font-size:.75rem;color:var(--text-3);">06:00 – 14:00</span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="shift-option">
                                            <input type="checkbox" name="shiftAfternoon" value="afternoon">
                                            <span>
                                                <strong style="font-size:.875rem;">Afternoon</strong><br>
                                                <span style="font-size:.75rem;color:var(--text-3);">14:00 – 22:00</span>
                                            </span>
                                        </label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="shift-option">
                                            <input type="checkbox" name="shiftNight" value="night">
                                            <span>
                                                <strong style="font-size:.875rem;">Night</strong><br>
                                                <span style="font-size:.75rem;color:var(--text-3);">22:00 – 06:00</span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label"><i class="fas fa-phone-alt"></i>Emergency Contact</label>
                                <div class="row g-2">
                                    <div class="col-md-4"><input type="text" class="form-control" name="emergencyName" placeholder="Contact Name"></div>
                                    <div class="col-md-4"><input type="text" class="form-control" name="emergencyRelationship" placeholder="Relationship"></div>
                                    <div class="col-md-4"><input type="tel" class="form-control" name="emergencyPhone" placeholder="Phone Number"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline-brand" data-bs-dismiss="modal"><i class="fas fa-times"></i>Cancel</button>
                        <button type="submit" class="btn-brand"><i class="fas fa-save"></i>Add Guard</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ── View Guard Modal ── -->
    <div class="modal fade" id="viewGuardModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-shield"></i>Guard Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="guardDetails">
                    <div class="text-center py-4">
                        <div style="width:36px;height:36px;border:3px solid var(--brand-100);border-top-color:var(--brand-500);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-brand" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-brand" onclick="editGuard(currentGuardId)"><i class="fas fa-edit"></i>Edit</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Assign Shift Modal ── -->
    <div class="modal fade" id="assignShiftModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-calendar-plus"></i>Assign Shift</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="assignShiftForm" method="POST" action="/shifts/assign">
                    <div class="modal-body">
                        <input type="hidden" name="guardId" id="shiftGuardId">
                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-user-shield"></i>Guard</label>
                            <input type="text" class="form-control" id="shiftGuardName" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-calendar"></i>Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="date" min="{{todayDate}}" required>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-clock"></i>Start Time <span class="text-danger">*</span></label>
                                <select class="form-select" name="startTime" required>
                                    <option value="">Select time</option>
                                    <option value="06:00">06:00 — Morning</option>
                                    <option value="14:00">14:00 — Afternoon</option>
                                    <option value="22:00">22:00 — Night</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label"><i class="fas fa-clock"></i>End Time <span class="text-danger">*</span></label>
                                <select class="form-select" name="endTime" required>
                                    <option value="">Select time</option>
                                    <option value="14:00">14:00 — Morning end</option>
                                    <option value="22:00">22:00 — Afternoon end</option>
                                    <option value="06:00">06:00 — Night end</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-map-marker-alt"></i>Zone <span class="text-danger">*</span></label>
                            <select class="form-select" name="zone" required>
                                <option value="">Select zone</option>
                                <option value="main_gate">Main Gate</option>
                                <option value="hostels">Hostels</option>
                                <option value="academic">Academic Area</option>
                                <option value="perimeter">Perimeter</option>
                                <option value="parking">Parking Lots</option>
                                <option value="admin">Admin Block</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="fas fa-sticky-note"></i>Notes</label>
                            <textarea class="form-control" name="notes" rows="2" placeholder="Special instructions…"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline-brand" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-brand"><i class="fas fa-calendar-check"></i>Assign Shift</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        let currentGuardId = null;
        let dtTable;

        $(document).ready(function() {
            dtTable = $('#guardsTable').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                language: {
                    searchPlaceholder: 'Search guards…',
                    lengthMenu: 'Show _MENU_ guards',
                    info: 'Showing _START_ to _END_ of _TOTAL_ guards'
                },
                columnDefs: [{ orderable: false, targets: 7 }]
            });
        });

        function viewGuard(id) {
            currentGuardId = id;
            document.getElementById('guardDetails').innerHTML = '<div class="text-center py-4"><div style="width:36px;height:36px;border:3px solid var(--brand-100);border-top-color:var(--brand-500);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div></div>';
            new bootstrap.Modal(document.getElementById('viewGuardModal')).show();

            fetch(`/api/guards/${id}`).then(r => r.json()).then(d => {
                document.getElementById('guardDetails').innerHTML = `
                    <div class="guard-hero">
                        <div class="guard-hero-avatar">${d.initials}</div>
                        <h4>${d.name}</h4>
                        <span class="badge-role role-${d.role}">${formatRole(d.role)}</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="detail-group"><div class="detail-label">Badge Number</div><div class="detail-value"><i class="fas fa-id-card"></i>${d.badgeNumber}</div></div>
                            <div class="detail-group"><div class="detail-label">Email</div><div class="detail-value"><i class="fas fa-envelope"></i>${d.email}</div></div>
                            <div class="detail-group"><div class="detail-label">Phone</div><div class="detail-value"><i class="fas fa-phone"></i>${d.phoneNumber}</div></div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-group"><div class="detail-label">Status</div><div class="detail-value">${d.isActive ? '<span class="status-badge status-active">Active</span>' : '<span class="status-badge status-inactive">Inactive</span>'}</div></div>
                            <div class="detail-group"><div class="detail-label">Last Login</div><div class="detail-value"><i class="fas fa-clock"></i>${d.lastLogin ? new Date(d.lastLogin).toLocaleString() : 'Never'}</div></div>
                            <div class="detail-group"><div class="detail-label">Joined</div><div class="detail-value"><i class="fas fa-calendar"></i>${new Date(d.createdAt).toLocaleDateString()}</div></div>
                        </div>
                    </div>
                    <div class="detail-group mt-1">
                        <div class="detail-label">Shift Preferences</div>
                        <div class="detail-value" style="flex-wrap:wrap;gap:.3rem;">
                            ${d.shiftPreferences?.preferredShifts?.map(s => `<span class="badge-zone">${s}</span>`).join('') || '<span style="color:var(--text-3);">No preferences set</span>'}
                        </div>
                    </div>
                    ${d.emergencyContact ? `
                    <div class="detail-group">
                        <div class="detail-label"><i class="fas fa-phone-alt me-1"></i>Emergency Contact</div>
                        <div class="detail-value" style="flex-direction:column;align-items:flex-start;gap:.1rem;">
                            <strong>${d.emergencyContact.name}</strong>
                            <span style="color:var(--text-3);font-size:.8rem;">${d.emergencyContact.relationship} · ${d.emergencyContact.phone}</span>
                        </div>
                    </div>` : ''}`;
            });
        }

        function editGuard(id) { window.location.href = `/guards/edit/${id}`; }

        function deleteGuard(id) {
            if (confirm('Delete this guard? This action cannot be undone.')) {
                fetch(`/guards/${id}`, { method: 'DELETE' })
                    .then(r => { if (r.ok) window.location.reload(); else alert('Failed to delete guard'); });
            }
        }

        function assignShift(id) {
            fetch(`/api/guards/${id}`).then(r => r.json()).then(d => {
                document.getElementById('shiftGuardId').value = id;
                document.getElementById('shiftGuardName').value = d.name;
                new bootstrap.Modal(document.getElementById('assignShiftModal')).show();
            });
        }

        function exportGuards() {
            const fmt = prompt('Export format (pdf / excel / csv):', 'excel');
            if (fmt) window.location.href = `/guards/export?format=${fmt}`;
        }

        function applyFilters() {
            const status = document.getElementById('statusFilter').value.toLowerCase();
            const role   = document.getElementById('roleFilter').value.toLowerCase();
            const zone   = document.getElementById('zoneFilter').value.toLowerCase();
            const search = document.getElementById('searchInput').value;

            $.fn.dataTable.ext.search = [];
            if (status || role || zone) {
                $.fn.dataTable.ext.search.push((settings, data) => {
                    if (status && !data[4].toLowerCase().includes(status)) return false;
                    if (role   && !data[2].toLowerCase().includes(role))   return false;
                    if (zone   && !data[5].toLowerCase().includes(zone))   return false;
                    return true;
                });
            }
            dtTable.search(search).draw();
        }

        function resetFilters() {
            ['statusFilter','roleFilter','zoneFilter'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('searchInput').value = '';
            $.fn.dataTable.ext.search = [];
            dtTable.search('').draw();
        }

        function formatRole(r) { return r ? r.charAt(0).toUpperCase() + r.slice(1) : r; }

        // Charts
        Chart.defaults.font.family = "'DM Sans', sans-serif";
        Chart.defaults.font.size = 12;
        Chart.defaults.color = '#94a3b8';

        document.addEventListener('DOMContentLoaded', function() {
            const zoneCtx = document.getElementById('zoneChart')?.getContext('2d');
            if (zoneCtx) {
                new Chart(zoneCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Main Gate','Hostels','Academic','Perimeter','Parking','Admin'],
                        datasets: [{
                            data: {{zoneStats}},
                            backgroundColor: ['#4f66e5','#12b76a','#f59e0b','#8b5cf6','#ef4444','#06b6d4'],
                            borderWidth: 0,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: { position:'bottom', labels: { padding:16, usePointStyle:true, pointStyleWidth:10 } }
                        },
                        animation: { animateRotate:true, duration:1000, easing:'easeOutQuart' }
                    }
                });
            }

            const perfCtx = document.getElementById('performanceChart')?.getContext('2d');
            if (perfCtx) {
                new Chart(perfCtx, {
                    type: 'line',
                    data: {
                        labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
                        datasets: [{
                            label: 'Patrol Completion %',
                            data: [95,92,98,94,96,89,91],
                            borderColor: '#4f66e5',
                            backgroundColor: ctx => {
                                const g = ctx.chart.ctx.createLinearGradient(0,0,0,200);
                                g.addColorStop(0,'rgba(79,102,229,.18)');
                                g.addColorStop(1,'rgba(79,102,229,0)');
                                return g;
                            },
                            borderWidth: 2, tension: .4, fill: true,
                            pointBackgroundColor: '#4f66e5', pointRadius: 4, pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero:false, min:80, max:100, grid: { color:'rgba(0,0,0,.05)' }, border: { dash:[4,4] } },
                            x: { grid: { display:false } }
                        },
                        animation: { duration:1200, easing:'easeOutQuart' }
                    }
                });
            }
        });

        // Auto-refresh guard status every 30 seconds
        setInterval(() => {
            fetch('/api/guards/status')
                .then(r => r.json())
                .then(d => { /* update inline status dots without reload */ })
                .catch(() => {});
        }, 30000);
    </script>
</body>
</html>
