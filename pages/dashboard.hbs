    <script>
        // Sidebar Toggle
        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });
        
        // Initialize Map
        document.addEventListener('DOMContentLoaded', function() {
            const mapElement = document.getElementById('liveMap');
            if (mapElement) {
                const map = L.map('liveMap').setView([-1.2864, 36.8172], 15); // Nairobi coordinates
                
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(map);
                
                // Add guard markers (example)
                const guards = [
                    { lat: -1.2864, lng: 36.8172, name: 'Guard 1', status: 'online' },
                    { lat: -1.2874, lng: 36.8182, name: 'Guard 2', status: 'online' },
                    { lat: -1.2854, lng: 36.8162, name: 'Guard 3', status: 'away' }
                ];
                
                guards.forEach(guard => {
                    const marker = L.marker([guard.lat, guard.lng]).addTo(map);
                    marker.bindPopup(`<b>${guard.name}</b><br>Status: ${guard.status}`);
                });
            }
        });
        
        // Incident Chart
        const incidentCtx = document.getElementById('incidentChart')?.getContext('2d');
        if (incidentCtx) {
            new Chart(incidentCtx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Incidents',
                        data: [3, 5, 2, 6, 4, 2, 1],
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                display: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }
        
        // Response Time Chart
        const responseCtx = document.getElementById('responseChart')?.getContext('2d');
        if (responseCtx) {
            new Chart(responseCtx, {
                type: 'bar',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Response Time (min)',
                        data: [2.5, 2.1, 2.8, 2.3, 2.0, 1.8, 1.9],
                        backgroundColor: '#764ba2',
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                display: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }
        
        // Update time every second
        function updateTime() {
            const timeElement = document.querySelector('.quick-stat-item:nth-child(2) span');
            if (timeElement) {
                const now = new Date();
                timeElement.textContent = now.toLocaleTimeString('en-US', { 
                    hour: '2-digit', 
                    minute: '2-digit',
                    second: '2-digit'
                });
            }
        }
        
        setInterval(updateTime, 1000);
        
        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('show') && 
                !sidebar.contains(event.target) && 
                !toggle.contains(event.target)) {
                sidebar.classList.remove('show');
            }
        });
    </script>
</body>
</html>