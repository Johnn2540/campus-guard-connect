<!--dashboard.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if user}}{{user.role}} Dashboard{{else}}Dashboard{{/if}} - Campus Guard Connect</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        :root {
            --brand-50:  #f0f3ff;
            --brand-100: #e0e7ff;
            --brand-400: #7c8fe8;
            --brand-500: #4f66e5;
            --brand-600: #3b52d4;
            --brand-700: #2c3fb5;
            --success:   #12b76a;
            --warning:   #f59e0b;
            --danger:    #ef4444;
            --bg:        #f4f6fb;
            --surface:   #ffffff;
            --border:    rgba(0,0,0,.07);
            --text-1:    #0f172a;
            --text-2:    #475569;
            --text-3:    #94a3b8;
            --sidebar-w: 270px;
            --nav-h:     72px;
            --radius-xl: 18px;
            --radius-lg: 12px;
            --radius-md: 8px;
            --shadow-sm: 0 1px 4px rgba(0,0,0,.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,.08);
            --shadow-lg: 0 12px 40px rgba(79,102,229,.18);
            --ease-spring: cubic-bezier(.34,1.56,.64,1);
            --ease-out:    cubic-bezier(.22,1,.36,1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            font-size: 15px;
            background: var(--bg);
            color: var(--text-1);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1,h2,h3,h4,h5,h6 { font-family: 'Syne', sans-serif; letter-spacing: -.02em; }
        a { text-decoration: none; color: inherit; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--brand-100); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--brand-400); }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes pulse-dot {
            0%,100% { box-shadow: 0 0 0 0 rgba(18,183,106,.5); }
            50%      { box-shadow: 0 0 0 6px rgba(18,183,106,0); }
        }
        @keyframes badge-pop {
            0%   { transform: scale(0); }
            70%  { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        /* ── Navbar ── */
        .navbar {
            position: fixed;
            inset: 0 0 auto 0;
            height: var(--nav-h);
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            z-index: 1030;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            animation: fadeIn .4s var(--ease-out) both;
        }

        .navbar-brand {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--brand-500);
            display: flex;
            align-items: center;
            gap: .6rem;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .brand-icon {
            width: 36px; height: 36px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            color: #fff; font-size: .9rem;
            box-shadow: 0 4px 12px rgba(79,102,229,.35);
            flex-shrink: 0;
        }

        .nav-search { flex: 1; max-width: 320px; position: relative; }
        .nav-search i {
            position: absolute; left: 13px; top: 50%;
            transform: translateY(-50%);
            color: var(--text-3); font-size: .85rem; pointer-events: none;
        }
        .nav-search input {
            width: 100%; height: 40px;
            padding: 0 1rem 0 2.25rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--bg);
            font-family: 'DM Sans', sans-serif; font-size: .875rem;
            color: var(--text-1); transition: border-color .2s, box-shadow .2s;
        }
        .nav-search input::placeholder { color: var(--text-3); }
        .nav-search input:focus {
            outline: none; border-color: var(--brand-400);
            box-shadow: 0 0 0 4px rgba(79,102,229,.12); background: var(--surface);
        }

        .nav-right { margin-left: auto; display: flex; align-items: center; gap: .75rem; }

        .nav-icon-btn {
            width: 40px; height: 40px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface);
            display: grid; place-items: center;
            color: var(--text-2); cursor: pointer; position: relative;
            transition: border-color .2s, color .2s, transform .15s var(--ease-spring);
        }
        .nav-icon-btn:hover { border-color: var(--brand-400); color: var(--brand-500); transform: translateY(-1px); }
        .nav-icon-btn .badge-count {
            position: absolute; top: -6px; right: -6px;
            background: var(--danger); color: #fff;
            font-size: .65rem; font-weight: 700;
            min-width: 18px; height: 18px; border-radius: 99px;
            display: grid; place-items: center; padding: 0 4px;
            border: 2px solid var(--surface);
            animation: badge-pop .4s var(--ease-spring) both;
        }

        .user-chip {
            display: flex; align-items: center; gap: .6rem;
            padding: .3rem .5rem .3rem .3rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg); cursor: pointer;
            transition: border-color .2s, background .2s;
        }
        .user-chip:hover { border-color: var(--brand-400); background: var(--brand-50); }

        .user-avatar {
            width: 34px; height: 34px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            color: #fff; font-family: 'Syne', sans-serif;
            font-size: .8rem; font-weight: 700; flex-shrink: 0;
        }

        .user-chip-info { display: none; }
        @media (min-width: 768px) {
            .user-chip-info { display: block; }
            .user-chip-info .name { font-family: 'Syne', sans-serif; font-size: .8rem; font-weight: 700; color: var(--text-1); line-height: 1.2; }
            .user-chip-info .role { font-size: .72rem; color: var(--text-3); text-transform: capitalize; }
        }

        .dropdown-menu {
            border: 1.5px solid var(--border) !important;
            border-radius: var(--radius-lg) !important;
            box-shadow: var(--shadow-md) !important;
            padding: .4rem !important;
            font-size: .875rem;
            animation: fadeUp .2s var(--ease-out) both;
        }
        .dropdown-item {
            border-radius: var(--radius-md);
            padding: .55rem .85rem;
            color: var(--text-2); font-weight: 500;
            transition: background .15s, color .15s;
        }
        .dropdown-item:hover { background: var(--brand-50); color: var(--brand-600); }
        .dropdown-item.text-danger:hover { background: #fff1f1; color: var(--danger); }
        .dropdown-divider { border-color: var(--border); margin: .3rem 0; }

        /* ── Sidebar ── */
        .sidebar {
            position: fixed;
            top: var(--nav-h); left: 0; bottom: 0;
            width: var(--sidebar-w);
            background: var(--surface);
            border-right: 1px solid var(--border);
            overflow-y: auto; z-index: 1020;
            transition: transform .3s var(--ease-out);
            padding: 1.25rem .875rem 2rem;
            animation: fadeIn .5s var(--ease-out) both;
        }
        .sidebar-overlay {
            display: none; position: fixed;
            inset: var(--nav-h) 0 0 0;
            background: rgba(0,0,0,.3); z-index: 1015;
            backdrop-filter: blur(2px);
        }
        @media (max-width: 991px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .sidebar.show ~ .sidebar-overlay { display: block; }
        }

        .menu-section { margin-bottom: 1.75rem; }
        .menu-section-title {
            font-family: 'DM Sans', sans-serif;
            font-size: .68rem; font-weight: 600;
            letter-spacing: .08em; text-transform: uppercase;
            color: var(--text-3); padding: 0 .625rem; margin-bottom: .5rem;
        }
        .menu-link {
            display: flex; align-items: center; gap: .75rem;
            padding: .6rem .75rem; border-radius: var(--radius-md);
            color: var(--text-2); font-weight: 500; font-size: .875rem;
            transition: background .2s, color .2s, transform .15s var(--ease-spring);
            position: relative;
        }
        .menu-link i { width: 20px; text-align: center; font-size: .95rem; color: var(--text-3); transition: color .2s; flex-shrink: 0; }
        .menu-link:hover { background: var(--brand-50); color: var(--brand-600); transform: translateX(3px); }
        .menu-link:hover i { color: var(--brand-500); }
        .menu-link.active {
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            color: #fff; box-shadow: var(--shadow-lg); font-weight: 600;
        }
        .menu-link.active i { color: rgba(255,255,255,.85); }
        .menu-link.active:hover { transform: translateX(3px); }
        .badge-new {
            margin-left: auto; background: var(--danger); color: #fff;
            font-size: .65rem; font-weight: 700;
            padding: 2px 7px; border-radius: 99px;
            animation: badge-pop .4s var(--ease-spring) both;
        }
        .menu-link.active .badge-new { background: rgba(255,255,255,.3); }

        /* ── Main Content ── */
        .main-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--nav-h);
            padding: 1.75rem;
            min-height: calc(100vh - var(--nav-h));
            transition: margin-left .3s var(--ease-out);
        }
        @media (max-width: 991px) { .main-content { margin-left: 0; } }

        .main-content > * { animation: fadeUp .45s var(--ease-out) both; }
        .main-content > *:nth-child(1) { animation-delay: .08s; }
        .main-content > *:nth-child(2) { animation-delay: .16s; }
        .main-content > *:nth-child(3) { animation-delay: .24s; }
        .main-content > *:nth-child(4) { animation-delay: .32s; }

        /* ── Welcome Banner ── */
        .welcome-banner {
            background: linear-gradient(130deg, var(--brand-600) 0%, #1e3a8a 100%);
            border-radius: var(--radius-xl);
            padding: 2rem 2.25rem; color: #fff;
            position: relative; overflow: hidden; margin-bottom: 1.75rem;
        }
        .welcome-banner::before, .welcome-banner::after {
            content: ''; position: absolute; border-radius: 50%;
            background: rgba(255,255,255,.06);
        }
        .welcome-banner::before { width: 280px; height: 280px; top: -100px; right: -60px; }
        .welcome-banner::after  { width: 180px; height: 180px; bottom: -80px; right: 120px; }
        .welcome-content { position: relative; z-index: 1; }
        .welcome-banner h2 { font-size: clamp(1.4rem,2.5vw,2rem); font-weight: 800; margin-bottom: .4rem; }
        .welcome-banner p  { opacity: .85; font-size: .95rem; margin-bottom: 1.25rem; }

        .quick-stats { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; }
        .quick-stat-item { display: flex; align-items: center; gap: .5rem; font-size: .875rem; font-weight: 500; }
        .quick-stat-item i { opacity: .8; font-size: 1rem; }

        /* ── Stat Cards ── */
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 1.5rem; height: 100%;
            position: relative; overflow: hidden;
            transition: transform .2s var(--ease-spring), box-shadow .2s;
        }
        .stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
        .stat-card::after {
            content: ''; position: absolute;
            bottom: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--brand-500), var(--brand-700));
            transform: scaleX(0); transform-origin: left;
            transition: transform .3s var(--ease-out);
        }
        .stat-card:hover::after { transform: scaleX(1); }

        .stat-icon {
            width: 52px; height: 52px; border-radius: var(--radius-lg);
            background: var(--brand-50); display: grid; place-items: center;
            margin-bottom: 1rem;
        }
        .stat-icon i { font-size: 1.4rem; color: var(--brand-500); }
        .stat-value { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: var(--text-1); line-height: 1; margin-bottom: .3rem; }
        .stat-label { font-size: .8rem; color: var(--text-3); font-weight: 500; text-transform: uppercase; letter-spacing: .04em; }
        .stat-badge { font-size: .72rem; font-weight: 600; padding: .2rem .55rem; border-radius: 99px; }
        .badge-up   { background: #dcfce7; color: #15803d; }
        .badge-down { background: #fee2e2; color: #b91c1c; }

        /* ── Cards ── */
        .card {
            background: var(--surface);
            border: 1px solid var(--border) !important;
            border-radius: var(--radius-xl) !important;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: box-shadow .2s;
        }
        .card:hover { box-shadow: var(--shadow-md); }
        .card-header {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border) !important;
            padding: 1.1rem 1.5rem !important;
            display: flex; align-items: center; justify-content: space-between;
        }
        .card-header h5 { font-size: .95rem; font-weight: 700; color: var(--text-1); margin: 0; display: flex; align-items: center; gap: .5rem; }
        .card-header h5 i { color: var(--brand-500); font-size: .9rem; }
        .card-header .btn-link {
            font-size: .8rem; font-weight: 600; color: var(--brand-500);
            display: flex; align-items: center; gap: .3rem;
            transition: color .15s, gap .2s;
        }
        .card-header .btn-link:hover { color: var(--brand-700); gap: .6rem; }
        .card-body { padding: 1.5rem !important; }

        /* ── Map ── */
        .map-container { height: 280px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
        #liveMap { height: 100%; width: 100%; }

        /* ── Guard List ── */
        .guard-list { list-style: none; padding: 0; margin: 0; }
        .guard-item {
            display: flex; align-items: center; gap: .875rem;
            padding: .875rem .25rem; border-bottom: 1px solid var(--border);
            transition: background .15s; border-radius: var(--radius-md);
        }
        .guard-item:last-child { border-bottom: none; }
        .guard-item:hover { background: var(--bg); }
        .guard-avatar {
            width: 40px; height: 40px; border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            display: grid; place-items: center;
            color: #fff; font-family: 'Syne', sans-serif;
            font-size: .8rem; font-weight: 700; flex-shrink: 0;
        }
        .guard-info { flex: 1; min-width: 0; }
        .guard-info h6 { font-size: .875rem; font-weight: 600; margin-bottom: 2px; color: var(--text-1); }
        .guard-info p  { font-size: .78rem; color: var(--text-3); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .guard-status { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
        .status-online  { background: var(--success); animation: pulse-dot 2.5s infinite; }
        .status-away    { background: var(--warning); }
        .status-offline { background: var(--text-3); }

        /* ── Incident List ── */
        .incident-list { list-style: none; padding: 0; margin: 0; }
        .incident-item {
            display: flex; align-items: center; gap: .875rem;
            padding: .875rem .25rem; border-bottom: 1px solid var(--border);
            transition: background .15s; border-radius: var(--radius-md);
        }
        .incident-item:last-child { border-bottom: none; }
        .incident-item:hover { background: var(--bg); }
        .incident-icon { width: 40px; height: 40px; border-radius: var(--radius-md); display: grid; place-items: center; font-size: 1rem; flex-shrink: 0; }
        .incident-high   { background: #fef2f2; color: var(--danger); }
        .incident-medium { background: #fffbeb; color: var(--warning); }
        .incident-low    { background: #f0fdf4; color: var(--success); }
        .incident-info { flex: 1; min-width: 0; }
        .incident-info h6 { font-size: .875rem; font-weight: 600; margin-bottom: 2px; color: var(--text-1); }
        .incident-info p  { font-size: .78rem; color: var(--text-3); margin: 0; }
        .incident-time { font-size: .75rem; color: var(--text-3); white-space: nowrap; }

        /* ── Progress ── */
        .progress-item { margin-bottom: 1rem; }
        .progress-item:last-child { margin-bottom: 0; }
        .progress-label { display: flex; justify-content: space-between; font-size: .8rem; font-weight: 500; color: var(--text-2); margin-bottom: .4rem; }
        .progress { height: 7px !important; background: var(--bg) !important; border-radius: 99px !important; overflow: hidden; }
        .progress-bar { background: linear-gradient(90deg, var(--brand-400), var(--brand-700)) !important; border-radius: 99px !important; transition: width 1.2s var(--ease-out) !important; }

        /* ── Quick Actions ── */
        .quick-actions { display: grid; grid-template-columns: repeat(2,1fr); gap: .75rem; }
        .action-btn {
            display: flex; flex-direction: column; align-items: center; gap: .5rem;
            padding: 1.1rem .75rem;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            color: var(--text-2); font-size: .78rem; font-weight: 600;
            cursor: pointer; text-align: center;
            transition: border-color .2s, background .2s, transform .2s var(--ease-spring), box-shadow .2s;
        }
        .action-btn i { font-size: 1.35rem; color: var(--brand-500); transition: transform .2s var(--ease-spring); }
        .action-btn:hover { border-color: var(--brand-400); background: var(--brand-50); color: var(--brand-600); transform: translateY(-3px); box-shadow: 0 6px 20px rgba(79,102,229,.15); }
        .action-btn:hover i { transform: scale(1.15) rotate(-5deg); }
        .action-btn:active { transform: translateY(-1px); }

        /* ── Weather ── */
        .weather-temp { font-family: 'Syne', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--text-1); line-height: 1; }
        .weather-meta { font-size: .8rem; color: var(--text-3); }
        .weather-stat h6 { font-size: .875rem; font-weight: 700; margin-bottom: 2px; color: var(--text-1); }
        .weather-stat small { font-size: .72rem; color: var(--text-3); }

        /* ── Sidebar toggle (mobile) ── */
        #sidebarToggle {
            display: none; width: 38px; height: 38px;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface);
            align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-2);
            transition: border-color .2s, color .2s; flex-shrink: 0;
        }
        #sidebarToggle:hover { border-color: var(--brand-400); color: var(--brand-500); }
        @media (max-width: 991px) {
            #sidebarToggle { display: flex; }
            .nav-search { display: none !important; }
        }

        .empty-state { text-align: center; padding: 2rem 1rem; color: var(--text-3); font-size: .875rem; }
        .empty-state i { font-size: 1.5rem; display: block; margin-bottom: .5rem; color: var(--success); }

        .btn-primary {
            background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
            border: none; font-family: 'DM Sans', sans-serif;
            font-weight: 600; border-radius: var(--radius-md);
            transition: transform .15s var(--ease-spring), box-shadow .15s;
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(79,102,229,.35); }

        .btn-light {
            font-family: 'DM Sans', sans-serif; font-weight: 600;
            border-radius: var(--radius-md);
            border: 2px solid rgba(255,255,255,.3);
            background: rgba(255,255,255,.15); color: #fff;
            backdrop-filter: blur(4px);
            transition: background .2s, border-color .2s, transform .15s var(--ease-spring);
        }
        .btn-light:hover { background: rgba(255,255,255,.25); border-color: rgba(255,255,255,.5); color: #fff; transform: translateY(-1px); }

        @media (prefers-color-scheme: dark) {
            :root { --bg: #0d1117; --surface: #161b22; --border: rgba(255,255,255,.08); --text-1: #f0f6fc; --text-2: #8b949e; --text-3: #484f58; }
            .stat-icon { background: rgba(79,102,229,.15); }
            .action-btn { background: var(--surface); }
            .action-btn:hover { background: rgba(79,102,229,.1); }
            .nav-search input { background: var(--bg); color: var(--text-1); }
        }
    </style>
</head>
<body class="{{#if user}}{{user.role}}{{/if}}">

    <!-- Navbar -->
    <nav class="navbar">
        <button id="sidebarToggle" aria-label="Toggle sidebar">
            <i class="fas fa-bars"></i>
        </button>

        <a class="navbar-brand" href="/dashboard">
            <span class="brand-icon"><i class="fas fa-shield-alt"></i></span>
            CampusGuard Connect
        </a>

        <div class="nav-search d-none d-lg-block">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search guards, incidents, reports…">
        </div>

        <div class="nav-right">
            <div class="nav-icon-btn" role="button" aria-label="Notifications">
                <i class="far fa-bell"></i>
                <span class="badge-count">{{notificationCount}}</span>
            </div>

            <div class="dropdown">
                <div class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
