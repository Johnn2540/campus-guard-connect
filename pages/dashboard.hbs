    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Sidebar
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        document.getElementById('sidebarToggle')?.addEventListener('click', () => sidebar.classList.toggle('show'));
        overlay?.addEventListener('click', () => sidebar.classList.remove('show'));

        // Live clock
        function updateClock() {
            const el = document.getElementById('liveClock');
            if (el) el.textContent = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        updateClock();
        setInterval(updateClock, 1000);

        // Animated progress bars
        function animateProgressBars() {
            document.querySelectorAll('.progress-bar[data-width]').forEach(bar => {
                setTimeout(() => { bar.style.width = bar.dataset.width; }, 400);
            });
        }

        // Staggered card reveal via IntersectionObserver
        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => {
                if (e.isIntersecting) { e.target.style.opacity = '1'; e.target.style.transform = 'translateY(0)'; }
            });
        }, { threshold: .1 });

        document.querySelectorAll('.stat-card, .card').forEach((el, i) => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(16px)';
            el.style.transition = `opacity .4s ease ${i * 0.05}s, transform .4s cubic-bezier(.22,1,.36,1) ${i * 0.05}s`;
            observer.observe(el);
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Map
            const mapEl = document.getElementById('liveMap');
            if (mapEl) {
                const map = L.map('liveMap', { zoomControl: true }).setView([-1.2864, 36.8172], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
                const guardIcon = L.divIcon({
                    className: '',
                    html: '<div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#4f66e5,#2c3fb5);display:grid;place-items:center;color:#fff;font-size:12px;box-shadow:0 4px 12px rgba(79,102,229,.4);"><i class="fas fa-user-shield"></i></div>',
                    iconSize: [28, 28], iconAnchor: [14, 14]
                });
                [{ lat: -1.2864, lng: 36.8172, name: 'Guard Alpha' },
                 { lat: -1.2874, lng: 36.8182, name: 'Guard Bravo' },
                 { lat: -1.2854, lng: 36.8162, name: 'Guard Charlie' }
                ].forEach(g => L.marker([g.lat, g.lng], { icon: guardIcon }).addTo(map).bindPopup('<strong>' + g.name + '</strong><br><span style="color:#12b76a">● Online</span>'));
            }
            animateProgressBars();
        });

        // Charts
        Chart.defaults.font.family = "'DM Sans', sans-serif";
        Chart.defaults.font.size = 12;
        Chart.defaults.color = '#94a3b8';

        const incidentCtx = document.getElementById('incidentChart')?.getContext('2d');
        if (incidentCtx) {
            new Chart(incidentCtx, {
                type: 'line',
                data: {
                    labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
                    datasets: [{
                        label: 'Incidents', data: [3,5,2,6,4,2,1],
                        borderColor: '#4f66e5',
                        backgroundColor: ctx => {
                            const g = ctx.chart.ctx.createLinearGradient(0,0,0,200);
                            g.addColorStop(0,'rgba(79,102,229,.18)'); g.addColorStop(1,'rgba(79,102,229,0)');
                            return g;
                        },
                        borderWidth: 2, tension: .4, fill: true,
                        pointBackgroundColor: '#4f66e5', pointRadius: 4, pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.05)' }, border: { dash: [4,4] } },
                        x: { grid: { display: false } }
                    },
                    animation: { duration: 1200, easing: 'easeOutQuart' }
                }
            });
        }

        const responseCtx = document.getElementById('responseChart')?.getContext('2d');
        if (responseCtx) {
            new Chart(responseCtx, {
                type: 'bar',
                data: {
                    labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
                    datasets: [{
                        label: 'Response (min)', data: [2.5,2.1,2.8,2.3,2.0,1.8,1.9],
                        backgroundColor: ctx => {
                            const g = ctx.chart.ctx.createLinearGradient(0,0,0,160);
                            g.addColorStop(0,'rgba(79,102,229,.9)'); g.addColorStop(1,'rgba(44,63,181,.5)');
                            return g;
                        },
                        borderRadius: 6, borderSkipped: false
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,.05)' }, border: { dash: [4,4] } },
                        x: { grid: { display: false } }
                    },
                    animation: { duration: 1200, delay: ctx => ctx.dataIndex * 80, easing: 'easeOutBounce' }
                }
            });
        }
    </script>
</body>
</html>
