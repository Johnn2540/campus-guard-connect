<!-- views/users.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management - Campus Guard Connect</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            background: white;
            padding: 1rem 2rem;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .navbar-brand i {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2rem;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .notification-badge {
            position: relative;
            cursor: pointer;
        }

        .notification-badge i {
            font-size: 1.3rem;
            color: #64748b;
            transition: color 0.3s ease;
        }

        .notification-badge:hover i {
            color: #667eea;
        }

        .badge-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: linear-gradient(135deg, #f56565 0%, #c53030 100%);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            background: #f8fafc;
        }

        .user-profile:hover {
            background: #eef2f6;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1rem;
        }

        .user-info {
            display: none;
        }

        @media (min-width: 768px) {
            .user-info {
                display: block;
            }
            
            .user-info h6 {
                font-weight: 700;
                color: #1e293b;
                margin-bottom: 0.2rem;
                font-size: 0.9rem;
            }
            
            .user-info p {
                color: #64748b;
                font-size: 0.8rem;
                margin-bottom: 0;
                text-transform: capitalize;
            }
        }

        /* Main Content */
        .main-content {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            animation: fadeInDown 0.5s ease-out;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .page-header h2 {
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.25rem;
            font-size: 2rem;
        }

        .page-header p {
            color: #64748b;
            margin-bottom: 0;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .btn-outline {
            border: 2px solid #e2e8f0;
            background: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            color: #4a5568;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-outline:hover {
            border-color: #667eea;
            color: #667eea;
        }

        /* Stats Cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.5s ease-out;
            animation-fill-mode: both;
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }
        .stat-card:nth-child(4) { animation-delay: 0.4s; }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: height 0.3s ease;
        }

        .stat-card:hover::before {
            height: 100%;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stat-icon i {
            font-size: 1.8rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .stat-trend {
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .trend-up {
            color: #48bb78;
        }

        .trend-down {
            color: #f56565;
        }

        /* Filter Bar */
        .filter-bar {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: flex-end;
            animation: fadeIn 0.6s ease-out;
        }

        .filter-group {
            flex: 1;
            min-width: 160px;
        }

        .filter-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.25rem;
            display: block;
        }

        .filter-select, .filter-input {
            width: 100%;
            padding: 0.6rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: white;
        }

        .filter-select:focus, .filter-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            outline: none;
        }

        .filter-actions {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .btn-filter {
            padding: 0.6rem 1.5rem;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            height: 42px;
        }

        .btn-filter:hover {
            background: #764ba2;
            transform: translateY(-2px);
        }

        .btn-reset {
            padding: 0.6rem 1.5rem;
            background: #e2e8f0;
            color: #4a5568;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            height: 42px;
        }

        .btn-reset:hover {
            background: #cbd5e0;
        }

        /* Users Table */
        .table-container {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
            animation: fadeIn 0.7s ease-out;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .table-header h5 {
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .table-header h5 i {
            color: #667eea;
        }

        .users-table {
            width: 100%;
            border-collapse: collapse;
        }

        .users-table th {
            text-align: left;
            padding: 1rem;
            background: #f8fafc;
            font-weight: 700;
            color: #4a5568;
            border-bottom: 2px solid #e2e8f0;
            font-size: 0.9rem;
        }

        .users-table td {
            padding: 1rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .users-table tbody tr {
            transition: all 0.3s ease;
        }

        .users-table tbody tr:hover {
            background: #f8fafc;
        }

        .user-info-cell {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-avatar-md {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1rem;
        }

        .user-details h6 {
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .user-details small {
            color: #64748b;
            font-size: 0.8rem;
        }

        .badge-role {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .role-admin {
            background: rgba(102, 126, 234, 0.15);
            color: #434190;
        }

        .role-supervisor {
            background: rgba(237, 137, 54, 0.15);
            color: #9c4221;
        }

        .role-guard {
            background: rgba(72, 187, 120, 0.15);
            color: #276749;
        }

        .role-student {
            background: rgba(160, 174, 192, 0.15);
            color: #4a5568;
        }

        .status-badge {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-active {
            background: rgba(72, 187, 120, 0.15);
            color: #276749;
        }

        .status-inactive {
            background: rgba(245, 101, 101, 0.15);
            color: #c53030;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.15);
            color: #b45309;
        }

        .action-btns {
            display: flex;
            gap: 0.5rem;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border: none;
            background: transparent;
            border-radius: 6px;
            color: #94a3b8;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .action-btn:hover {
            background: #eef2f6;
            color: #667eea;
            transform: translateY(-2px);
        }

        .action-btn.view-btn:hover {
            color: #4299e1;
        }

        .action-btn.edit-btn:hover {
            color: #48bb78;
        }

        .action-btn.reset-btn:hover {
            color: #9f7aea;
        }

        .action-btn.delete-btn:hover {
            color: #f56565;
        }

        /* Modal Styles */
        .modal-content {
            border: none;
            border-radius: 20px;
            overflow: hidden;
        }

        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1.5rem;
            border: none;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            padding: 1.5rem;
            border-top: 2px solid #e2e8f0;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .form-control, .form-select {
            height: 48px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            outline: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #f56565;
        }

        .invalid-feedback {
            color: #f56565;
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }

        /* User Details in Modal */
        .user-detail-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 0.25rem;
            font-size: 0.9rem;
        }

        .user-detail-value {
            color: #1e293b;
            margin-bottom: 1rem;
            padding: 0.5rem;
            background: #f8fafc;
            border-radius: 8px;
        }

        .activity-timeline {
            position: relative;
            padding-left: 2rem;
        }

        .activity-item {
            position: relative;
            padding-bottom: 1rem;
        }

        .activity-item::before {
            content: '';
            position: absolute;
            left: -1.5rem;
            top: 0;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #667eea;
            border: 2px solid white;
            box-shadow: 0 0 0 2px #667eea;
        }

        .activity-item::after {
            content: '';
            position: absolute;
            left: -1.25rem;
            top: 1rem;
            bottom: 0;
            width: 2px;
            background: #e2e8f0;
        }

        .activity-item:last-child::after {
            display: none;
        }

        .activity-time {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-bottom: 0.25rem;
        }

        .activity-action {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .activity-desc {
            font-size: 0.9rem;
            color: #64748b;
        }

        /* Loading Spinner */
        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #e2e8f0;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 2rem auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-content {
                padding: 1rem;
            }
            
            .stats-row {
                grid-template-columns: 1fr 1fr;
            }
            
            .filter-bar {
                flex-direction: column;
            }
            
            .filter-group {
                width: 100%;
            }
            
            .users-table {
                display: block;
                overflow-x: auto;
            }
            
            .user-info-cell {
                min-width: 200px;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">
                <i class="fas fa-shield-alt"></i>
                CampusGuard Connect
            </a>
            
            <div class="user-menu">
                <div class="notification-badge">
                    <i class="far fa-bell"></i>
                    <span class="badge-count">{{notificationCount}}</span>
                </div>
                
                <div class="dropdown">
                    <div class="user-profile" data-bs-toggle="dropdown">
                        <div class="user-avatar">
                            {{#if user}}
                                {{user.initials}}
                            {{else}}
                                U
                            {{/if}}
                        </div>
                        <div class="user-info">
                            <h6>{{user.name}}</h6>
                            <p>{{user.role}}</p>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="/settings"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h2><i class="fas fa-users-cog me-2" style="color: #667eea;"></i>User Management</h2>
                <p>Manage system users, roles, and permissions</p>
            </div>
            
            <div class="header-actions">
                <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="fas fa-user-plus"></i>
                    Add New User
                </button>
                <button class="btn-outline" onclick="exportUsers()">
                    <i class="fas fa-download"></i>
                    Export
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <span class="stat-trend trend-up">
                        <i class="fas fa-arrow-up"></i> {{stats.newThisMonth}} this month
                    </span>
                </div>
                <div class="stat-value">{{stats.totalUsers}}</div>
                <div class="stat-label">Total Users</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                </div>
                <div class="stat-value">{{stats.activeUsers}}</div>
                <div class="stat-label">Active Users</div>
                <small class="text-muted">{{stats.activePercentage}}% of total</small>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                </div>
                <div class="stat-value">{{stats.guardCount}}</div>
                <div class="stat-label">Security Guards</div>
                <small class="text-muted">{{stats.supervisorCount}} supervisors</small>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-user-clock"></i>
                    </div>
                </div>
                <div class="stat-value">{{stats.onlineNow}}</div>
                <div class="stat-label">Online Now</div>
                <small class="text-muted">Last 30 minutes</small>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="filter-group">
                <label><i class="fas fa-filter me-1"></i>Role</label>
                <select class="filter-select" id="roleFilter">
                    <option value="">All Roles</option>
                    <option value="admin">Admin</option>
                    <option value="supervisor">Supervisor</option>
                    <option value="guard">Guard</option>
                    <option value="student">Student</option>
                </select>
            </div>

            <div class="filter-group">
                <label><i class="fas fa-circle me-1"></i>Status</label>
                <select class="filter-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="pending">Pending</option>
                </select>
            </div>

            <div class="filter-group">
                <label><i class="fas fa-search me-1"></i>Search</label>
                <input type="text" class="filter-input" id="searchInput" placeholder="Name, email, badge...">
            </div>

            <div class="filter-actions">
                <button class="btn-filter" onclick="applyFilters()">
                    <i class="fas fa-filter me-2"></i>Apply
                </button>
                <button class="btn-reset" onclick="resetFilters()">
                    <i class="fas fa-undo me-2"></i>Reset
                </button>
            </div>
        </div>

        <!-- Users Table -->
        <div class="table-container">
            <div class="table-header">
                <h5>
                    <i class="fas fa-list"></i>
                    System Users
                </h5>
                <div>
                    <span class="me-3"><i class="fas fa-check-circle text-success me-1"></i> {{stats.activeUsers}} Active</span>
                    <span><i class="fas fa-clock text-warning me-1"></i> {{stats.pendingUsers}} Pending</span>
                </div>
            </div>
            
            <table class="users-table" id="usersTable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Contact</th>
                        <th>Badge/ID</th>
                        <th>Status</th>
                        <th>Last Active</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                    <tr>
                        <td>
                            <div class="user-info-cell">
                                <div class="user-avatar-md">
                                    {{this.initials}}
                                </div>
                                <div class="user-details">
                                    <h6>{{this.name}}</h6>
                                    <small class="text-muted">{{this.email}}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-role role-{{this.role}}">
                                {{formatRole this.role}}
                            </span>
                        </td>
                        <td>
                            <div><i class="fas fa-phone me-1 text-muted"></i> {{this.phoneNumber}}</div>
                            {{#if this.institution}}
                            <small class="text-muted"><i class="fas fa-building me-1"></i> {{this.institution}}</small>
                            {{/if}}
                        </td>
                        <td>
                            {{#if this.badgeNumber}}
                                <span class="fw-bold">{{this.badgeNumber}}</span>
                            {{else}}
                                <span class="text-muted">N/A</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if this.isActive}}
                                <span class="status-badge status-active">Active</span>
                            {{else}}
                                <span class="status-badge status-inactive">Inactive</span>
                            {{/if}}
                        </td>
                        <td>
                            {{#if this.lastLogin}}
                                <div>{{formatDate this.lastLogin "MMM DD, YYYY"}}</div>
                                <small class="text-muted">{{formatDate this.lastLogin "HH:mm"}}</small>
                            {{else}}
                                <span class="text-muted">Never</span>
                            {{/if}}
                        </td>
                        <td>
                            <div>{{formatDate this.createdAt "MMM DD, YYYY"}}</div>
                            <small class="text-muted">{{formatDate this.createdAt "HH:mm"}}</small>
                        </td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn view-btn" onclick="viewUser('{{this._id}}')" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn edit-btn" onclick="editUser('{{this._id}}')" title="Edit User">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="action-btn reset-btn" onclick="resetPassword('{{this._id}}')" title="Reset Password">
                                    <i class="fas fa-key"></i>
                                </button>
                                <button class="action-btn delete-btn" onclick="deleteUser('{{this._id}}')" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <i class="fas fa-users fa-4x mb-3" style="color: #cbd5e0;"></i>
                            <h5 style="color: #94a3b8;">No users found</h5>
                            <p class="text-muted">Click "Add New User" to create your first user</p>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add User Modal -->
    <div class="modal fade" id="addUserModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-user-plus me-2"></i>
                        Add New User
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="addUserForm" method="POST" action="/admin/users/add">
                    <div class="modal-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-user me-2" style="color: #667eea;"></i>
                                    First Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" name="firstName" required>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-user me-2" style="color: #667eea;"></i>
                                    Last Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" name="lastName" required>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-envelope me-2" style="color: #667eea;"></i>
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input type="email" class="form-control" name="email" required>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-phone me-2" style="color: #667eea;"></i>
                                    Phone Number
                                </label>
                                <input type="tel" class="form-control" name="phoneNumber">
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-tag me-2" style="color: #667eea;"></i>
                                    Role <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" name="role" required>
                                    <option value="">Select role...</option>
                                    <option value="admin">Administrator</option>
                                    <option value="supervisor">Supervisor</option>
                                    <option value="guard">Security Guard</option>
                                    <option value="student">Student</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-id-card me-2" style="color: #667eea;"></i>
                                    Badge Number
                                </label>
                                <input type="text" class="form-control" name="badgeNumber" 
                                       placeholder="GC-{{year}}-{{inc lastBadge}}">
                                <small class="text-muted">Required for guards/supervisors</small>
                            </div>
                            
                            <div class="col-12">
                                <label class="form-label">
                                    <i class="fas fa-building me-2" style="color: #667eea;"></i>
                                    Institution
                                </label>
                                <input type="text" class="form-control" name="institution" 
                                       placeholder="University/Organization">
                            </div>
                            
                            <div class="col-12">
                                <label class="form-label">
                                    <i class="fas fa-lock me-2" style="color: #667eea;"></i>
                                    Temporary Password
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="tempPassword" 
                                           name="tempPassword" value="{{generatePassword}}" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="generateNewPassword()">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPassword()">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                                <small class="text-muted">User can change this after first login</small>
                            </div>
                            
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="sendEmail" id="sendEmail" checked>
                                    <label class="form-check-label" for="sendEmail">
                                        Send welcome email with login credentials
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-save me-2"></i>Add User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- View User Modal -->
    <div class="modal fade" id="viewUserModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-user me-2"></i>
                        User Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="userDetails">
                    <!-- Dynamic content loaded via JS -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-primary" onclick="editUser(currentUserId)">
                        <i class="fas fa-edit me-2"></i>Edit User
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Password Confirmation Modal -->
    <div class="modal fade" id="resetPasswordModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-key me-2"></i>
                        Reset Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to reset the password for <strong id="resetUserName"></strong>?</p>
                    <p>A new temporary password will be generated and sent to their email.</p>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        New password: <strong id="newPassword"></strong>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-primary" onclick="confirmResetPassword()">
                        <i class="fas fa-key me-2"></i>Reset Password
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        // Initialize DataTable
        $(document).ready(function() {
            const table = $('#usersTable').DataTable({
                pageLength: 10,
                order: [[6, 'desc']],
                language: {
                    search: '<i class="fas fa-search"></i>',
                    searchPlaceholder: 'Search users...',
                    lengthMenu: 'Show _MENU_ users'
                },
                columnDefs: [
                    { orderable: false, targets: 7 } // Actions column
                ]
            });

            // Initialize Select2 for role filter
            $('#roleFilter').select2({
                minimumResultsForSearch: Infinity,
                width: '100%'
            });
        });

        // Current user ID for modals
        let currentUserId = null;
        let newTempPassword = '';

        // View User
        function viewUser(id) {
            currentUserId = id;
            fetch(`/api/users/${id}`)
                .then(response => response.json())
                .then(data => {
                    const modalBody = document.getElementById('userDetails');
                    modalBody.innerHTML = `
                        <div class="text-center mb-4">
                            <div class="user-avatar-md" style="width: 80px; height: 80px; margin: 0 auto; font-size: 2rem;">
                                ${data.initials}
                            </div>
                            <h4 class="mt-3">${data.name}</h4>
                            <span class="badge-role role-${data.role}">${formatRole(data.role)}</span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="user-detail-label">Email</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-envelope me-2"></i>${data.email}
                                </div>
                                
                                <div class="user-detail-label">Phone</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-phone me-2"></i>${data.phoneNumber || 'Not provided'}
                                </div>
                                
                                <div class="user-detail-label">Badge Number</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-id-card me-2"></i>${data.badgeNumber || 'N/A'}
                                </div>
                                
                                <div class="user-detail-label">Institution</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-building me-2"></i>${data.institution || 'Not provided'}
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="user-detail-label">Status</div>
                                <div class="user-detail-value">
                                    ${data.isActive ? 
                                        '<span class="status-badge status-active">Active</span>' : 
                                        '<span class="status-badge status-inactive">Inactive</span>'}
                                </div>
                                
                                <div class="user-detail-label">Last Login</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-clock me-2"></i>${data.lastLogin ? new Date(data.lastLogin).toLocaleString() : 'Never'}
                                </div>
                                
                                <div class="user-detail-label">Joined</div>
                                <div class="user-detail-value">
                                    <i class="fas fa-calendar me-2"></i>${new Date(data.createdAt).toLocaleString()}
                                </div>
                                
                                <div class="user-detail-label">Shift Preferences</div>
                                <div class="user-detail-value">
                                    ${data.shiftPreferences?.preferredShifts?.map(s => 
                                        `<span class="badge bg-light text-dark me-1">${s}</span>`
                                    ).join('') || 'None set'}
                                </div>
                            </div>
                        </div>
                        
                        ${data.emergencyContact?.name ? `
                        <h6 class="mt-4"><i class="fas fa-phone-alt me-2"></i>Emergency Contact</h6>
                        <div class="user-detail-value">
                            <strong>${data.emergencyContact.name}</strong> (${data.emergencyContact.relationship})<br>
                            ${data.emergencyContact.phone}
                        </div>
                        ` : ''}
                        
                        <h6 class="mt-4"><i class="fas fa-history me-2"></i>Recent Activity</h6>
                        <div class="activity-timeline">
                            ${data.recentActivity?.map(activity => `
                                <div class="activity-item">
                                    <div class="activity-time">${new Date(activity.timestamp).toLocaleString()}</div>
                                    <div class="activity-action">${activity.action}</div>
                                    <div class="activity-desc">${activity.description}</div>
                                </div>
                            `).join('') || '<p class="text-muted">No recent activity</p>'}
                        </div>
                    `;
                    
                    new bootstrap.Modal(document.getElementById('viewUserModal')).show();
                });
        }

        // Edit User
        function editUser(id) {
            window.location.href = `/admin/users/edit/${id}`;
        }

        // Delete User
        function deleteUser(id) {
            if (confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                fetch(`/admin/users/${id}`, {
                    method: 'DELETE'
                }).then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Failed to delete user');
                    }
                });
            }
        }

        // Reset Password
        function resetPassword(id) {
            currentUserId = id;
            
            // Get user name
            fetch(`/api/users/${id}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('resetUserName').textContent = data.name;
                    
                    // Generate new password
                    newTempPassword = generateRandomPassword();
                    document.getElementById('newPassword').textContent = newTempPassword;
                    
                    new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
                });
        }

        // Confirm Reset Password
        function confirmResetPassword() {
            fetch(`/admin/users/${currentUserId}/reset-password`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ newPassword: newTempPassword })
            }).then(response => {
                if (response.ok) {
                    alert('Password reset successfully. User will receive an email with the new password.');
                    bootstrap.Modal.getInstance(document.getElementById('resetPasswordModal')).hide();
                } else {
                    alert('Failed to reset password');
                }
            });
        }

        // Generate random password
        function generateRandomPassword() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%';
            let password = '';
            for (let i = 0; i < 12; i++) {
                password += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            return password;
        }

        // Generate new password in form
        function generateNewPassword() {
            document.getElementById('tempPassword').value = generateRandomPassword();
        }

        // Copy password to clipboard
        function copyPassword() {
            const password = document.getElementById('tempPassword');
            password.select();
            document.execCommand('copy');
            alert('Password copied to clipboard');
        }

        // Export Users
        function exportUsers() {
            const format = prompt('Export format (csv/json):', 'csv');
            if (format) {
                window.location.href = `/admin/users/export?format=${format}`;
            }
        }

        // Filter Functions
        function applyFilters() {
            const role = document.getElementById('roleFilter').value;
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('searchInput').value;
            
            const table = $('#usersTable').DataTable();
            
            // Custom filtering
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    const row = table.row(dataIndex).data();
                    const rowRole = data[1].toLowerCase();
                    const rowStatus = data[4].toLowerCase();
                    
                    if (role && !rowRole.includes(role)) return false;
                    if (status && !rowStatus.includes(status)) return false;
                    
                    return true;
                }
            );
            
            table.search(search).draw();
        }

        function resetFilters() {
            document.getElementById('roleFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('searchInput').value = '';
            
            // Trigger Select2 update
            $('#roleFilter').trigger('change');
            
            const table = $('#usersTable').DataTable();
            $.fn.dataTable.ext.search.pop();
            table.search('').columns().search('').draw();
        }

        // Helper Functions
        function formatRole(role) {
            return role.charAt(0).toUpperCase() + role.slice(1);
        }

        // Auto-refresh every 60 seconds for online status
        setInterval(() => {
            fetch('/api/users/online-status')
                .then(response => response.json())
                .then(data => {
                    // Update online count in stats
                    const onlineStat = document.querySelector('.stat-card:last-child .stat-value');
                    if (onlineStat) {
                        onlineStat.textContent = data.online;
                    }
                });
        }, 60000);
    </script>
</body>
</html>