                    <div class="language-options">
                        <div class="language-option {{#if (eq user.language "en")}}active{{/if}}" onclick="setLanguage('en')">
                            <div class="language-flag">EN</div>
                            <span class="language-name">English</span>
                        </div>
                        <div class="language-option {{#if (eq user.language "sw")}}active{{/if}}" onclick="setLanguage('sw')">
                            <div class="language-flag">SW</div>
                            <span class="language-name">Kiswahili</span>
                        </div>
                        <div class="language-option {{#if (eq user.language "fr")}}active{{/if}}" onclick="setLanguage('fr')">
                            <div class="language-flag">FR</div>
                            <span class="language-name">Français</span>
                        </div>
                    </div>

                    <div class="section-title mt-4">Regional Settings</div>
