                            <option value="medium" {{#if (eq user.accessibility.fontSize "medium")}}selected{{/if}}>Medium</option>
                            <option value="large" {{#if (eq user.accessibility.fontSize "large")}}selected{{/if}}>Large</option>
                            <option value="x-large" {{#if (eq user.accessibility.fontSize "x-large")}}selected{{/if}}>Extra Large</option>
                        </select>
