                        <p>Manage API keys for integrations</p>
                    </div>

                    <button class="btn-primary mb-4" onclick="generateApiKey()">
                        <i class="fas fa-plus-circle me-2"></i>Generate New API Key
                    </button>

                    {{#each apiKeys}}
                    <div class="api-key-item">
                        <div class="api-key-info">
                            <h5>{{this.name}}</h5>
                            <p>Created: {{formatDate this.createdAt}} • Last used: {{#if this.lastUsed}}{{formatDate this.lastUsed}}{{else}}Never{{/if}}</p>
                        </div>
                        <div class="api-key-value">{{this.key}}</div>
                        <div class="api-key-actions">
                            <button class="action-btn" onclick="copyApiKey('{{this.key}}')" title="Copy">
                                <i class="fas fa-copy"></i>
                            </button>
                            <button class="action-btn" onclick="revokeApiKey('{{this.id}}')" title="Revoke">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    {{else}}
                    <p class="text-muted text-center py-4">No API keys generated yet</p>
                    {{/each}}
