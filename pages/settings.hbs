                <!-- Webhooks Section -->
                <div id="webhooks" class="settings-section" style="display: none;">
                    <div class="settings-header">
                        <h3>Webhooks</h3>
                        <p>Configure webhook endpoints for real-time notifications</p>
                    </div>

                    <button class="btn-primary mb-4" onclick="addWebhook()">
                        <i class="fas fa-plus-circle me-2"></i>Add Webhook
                    </button>

                    {{#each webhooks}}
                    <div class="api-key-item">
                        <div class="api-key-info">
                            <h5>{{this.url}}</h5>
                            <p>Events: {{this.events}} • Created: {{formatDate this.createdAt}}</p>
                        </div>
                        <div class="api-key-actions">
                            <button class="action-btn" onclick="testWebhook('{{this.id}}')" title="Test">
                                <i class="fas fa-play"></i>
                            </button>
                            <button class="action-btn" onclick="editWebhook('{{this.id}}')" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn" onclick="deleteWebhook('{{this.id}}')" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    {{else}}
                    <p class="text-muted text-center py-4">No webhooks configured</p>
                    {{/each}}
                </div>

                <!-- Integrations Section -->
                <div id="integrations" class="settings-section" style="display: none;">
                    <div class="settings-header">
                        <h3>Connected Apps</h3>
                        <p>Manage third-party application integrations</p>
                    </div>

                    <div class="integration-grid">
                        <div class="integration-card">
                            <div class="integration-icon">
                                <i class="fab fa-slack"></i>
                            </div>
                            <h5>Slack</h5>
                            <p>Receive notifications in your Slack workspace</p>
                            <span class="integration-status {{#if integrations.slack}}status-connected{{else}}status-disconnected{{/if}}">
                                {{#if integrations.slack}}Connected{{else}}Disconnected{{/if}}
                            </span>
                            <button class="btn-outline w-100" onclick="toggleIntegration('slack')">
                                {{#if integrations.slack}}Disconnect{{else}}Connect{{/if}}
                            </button>
                        </div>

                        <div class="integration-card">
                            <div class="integration-icon">
                                <i class="fab fa-telegram"></i>
                            </div>
                            <h5>Telegram</h5>
                            <p>Get alerts via Telegram bot</p>
                            <span class="integration-status {{#if integrations.telegram}}status-connected{{else}}status-disconnected{{/if}}">
                                {{#if integrations.telegram}}Connected{{else}}Disconnected{{/if}}
                            </span>
                            <button class="btn-outline w-100" onclick="toggleIntegration('telegram')">
                                {{#if integrations.telegram}}Disconnect{{else}}Connect{{/if}}
                            </button>
                        </div>

                        <div class="integration-card">
                            <div class="integration-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <h5>Microsoft 365</h5>
                            <p>Sync with Outlook calendar</p>
                            <span class="integration-status {{#if integrations.outlook}}status-connected{{else}}status-disconnected{{/if}}">
                                {{#if integrations.outlook}}Connected{{else}}Disconnected{{/if}}
                            </span>
                            <button class="btn-outline w-100" onclick="toggleIntegration('outlook')">
                                {{#if integrations.outlook}}Disconnect{{else}}Connect{{/if}}
                            </button>
                        </div>

                        <div class="integration-card">
                            <div class="integration-icon">
                                <i class="fab fa-google"></i>
                            </div>
                            <h5>Google Workspace</h5>
                            <p>Sync with Google Calendar</p>
                            <span class="integration-status {{#if integrations.google}}status-connected{{else}}status-disconnected{{/if}}">
                                {{#if integrations.google}}Connected{{else}}Disconnected{{/if}}
                            </span>
                            <button class="btn-outline w-100" onclick="toggleIntegration('google')">
                                {{#if integrations.google}}Disconnect{{else}}Connect{{/if}}
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Backup & Restore Section -->
                <div id="backup" class="settings-section" style="display: none;">
                    <div class="settings-header">
                        <h3>Backup & Restore</h3>
                        <p>Manage your data backups</p>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <button class="btn-primary" onclick="createBackup()">
                            <i class="fas fa-database me-2"></i>Create Backup
                        </button>
                        <button class="btn-outline" onclick="restoreBackup()">
                            <i class="fas fa-upload me-2"></i>Restore Backup
                        </button>
                        <button class="btn-outline" onclick="scheduleBackup()">
                            <i class="fas fa-clock me-2"></i>Schedule Backup
                        </button>
                    </div>

                    <div class="section-title">Recent Backups</div>
                    <div class="backup-list">
                        {{#each backups}}
                        <div class="backup-item">
                            <div class="backup-info">
                                <div class="backup-icon">
                                    <i class="fas fa-file-archive"></i>
                                </div>
                                <div class="backup-details">
                                    <h6>{{this.name}}</h6>
                                    <p>{{formatDate this.createdAt}}</p>
                                </div>
                            </div>
                            <div class="backup-size">{{this.size}}</div>
                            <div class="api-key-actions">
                                <button class="action-btn" onclick="downloadBackup('{{this.id}}')" title="Download">
                                    <i class="fas fa-download"></i>
                                </button>
                                <button class="action-btn" onclick="restoreBackup('{{this.id}}')" title="Restore">
                                    <i class="fas fa-upload"></i>
                                </button>
                                <button class="action-btn" onclick="deleteBackup('{{this.id}}')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        {{else}}
                        <div class="text-center py-4">
                            <p class="text-muted">No backups available</p>
                        </div>
                        {{/each}}
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="danger-zone">
                    <div class="danger-zone-title">
                        <i class="fas fa-exclamation-triangle"></i>
                        Danger Zone
                    </div>

                    <div class="danger-zone-item">
                        <div>
                            <h5>Deactivate Account</h5>
                            <p class="text-muted">Temporarily disable your account</p>
                        </div>
                        <button class="btn-outline" onclick="deactivateAccount()">
                            Deactivate
                        </button>
                    </div>

                    <div class="danger-zone-item">
                        <div>
                            <h5>Delete Account</h5>
                            <p class="text-muted">Permanently delete your account and all data</p>
                        </div>
                        <button class="btn-danger" onclick="deleteAccount()">
                            Delete Account
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-key me-2"></i>
                        Change Password
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="changePasswordForm">
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label class="form-label">Current Password</label>
                            <input type="password" class="form-control" name="currentPassword" required>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" class="form-control" name="newPassword" required minlength="8">
                            <div class="form-text">Minimum 8 characters with at least one number and one special character</div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" class="form-control" name="confirmPassword" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Generate API Key Modal -->
    <div class="modal fade" id="apiKeyModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-key me-2"></i>
                        Generate API Key
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="apiKeyForm">
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">Key Name</label>
                            <input type="text" class="form-control" name="name" placeholder="e.g., Development, Production" required>
                        </div>
                        
                        <div class="form-group mt-3">
                            <label class="form-label">Permissions</label>
                            <select class="form-select" name="permissions" multiple>
                                <option value="read">Read Only</option>
                                <option value="write">Write</option>
                                <option value="delete">Delete</option>
                                <option value="admin">Admin</option>
                            </select>
                            <div class="form-text">Hold Ctrl/Cmd to select multiple</div>
                        </div>
                        
                        <div class="form-group mt-3">
                            <label class="form-label">Expiration</label>
                            <select class="form-select" name="expiration">
                                <option value="30">30 days</option>
                                <option value="90">90 days</option>
                                <option value="365">1 year</option>
                                <option value="never">Never expires</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-primary">Generate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Webhook Modal -->
    <div class="modal fade" id="webhookModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-webhook me-2"></i>
                        Add Webhook
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="webhookForm">
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="form-label">Webhook URL</label>
                            <input type="url" class="form-control" name="url" placeholder="https://example.com/webhook" required>
                        </div>
                        
                        <div class="form-group mt-3">
                            <label class="form-label">Events</label>
                            <select class="form-select" name="events" multiple size="4">
                                <option value="incident.created">Incident Created</option>
                                <option value="incident.updated">Incident Updated</option>
                                <option value="patrol.started">Patrol Started</option>
                                <option value="patrol.completed">Patrol Completed</option>
                                <option value="shift.assigned">Shift Assigned</option>
                                <option value="shift.reminder">Shift Reminder</option>
                            </select>
                            <div class="form-text">Hold Ctrl/Cmd to select multiple</div>
                        </div>
                        
                        <div class="form-group mt-3">
                            <label class="form-label">Secret (Optional)</label>
                            <input type="text" class="form-control" name="secret" placeholder="Webhook secret for verification">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-primary">Add Webhook</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    
    <script>
        // Initialize Select2
        $(document).ready(function() {
            $('select[multiple]').select2({
                width: '100%',
                placeholder: 'Select permissions'
            });
        });

        // Section switching
        function switchSection(sectionId) {
            document.querySelectorAll('.settings-menu a').forEach(link => {
                link.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            document.querySelectorAll('.settings-section').forEach(section => {
                section.style.display = 'none';
            });
            document.getElementById(sectionId).style.display = 'block';
        }

        // Save all settings
        function saveAllSettings() {
            const settings = {
                // Account settings
                displayName: document.querySelector('input[name="displayName"]').value,
                timezone: document.querySelector('select[name="timezone"]').value,
                dateFormat: document.querySelector('select[name="dateFormat"]').value,
                timeFormat: document.querySelector('select[name="timeFormat"]').value,
                firstDayOfWeek: document.querySelector('select[name="firstDayOfWeek"]').value,
                
                // Session timeout
                sessionTimeout: document.querySelector('select[name="sessionTimeout"]').value,
                
                // Privacy
                profileVisibility: document.querySelector('select[name="profileVisibility"]').value,
                
                // Regional
                country: document.querySelector('select[name="country"]').value,
                currency: document.querySelector('select[name="currency"]').value,
                measurement: document.querySelector('select[name="measurement"]').value,
                
                // Accessibility
                fontSize: document.querySelector('select[name="fontSize"]').value
            };

            fetch('/api/settings/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(settings)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Settings saved successfully', 'success');
                } else {
                    showToast('Failed to save settings', 'error');
                }
            });
        }

        // Theme switching
        function setTheme(theme) {
            document.querySelectorAll('.theme-option').forEach(option => {
                option.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            // Apply theme
            document.body.className = theme;
            
            fetch('/api/settings/theme', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ theme })
            });
        }

        // Language switching
        function setLanguage(language) {
            document.querySelectorAll('.language-option').forEach(option => {
                option.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            fetch('/api/settings/language', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ language })
            }).then(() => {
                showToast('Language updated. Refresh to see changes.', 'info');
            });
        }

        // Toggle functions
        function toggleTwoFactor() {
            fetch('/api/settings/2fa/toggle', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = document.querySelector('.toggle-switch');
                        toggle.classList.toggle('active');
                        showToast(data.message, 'success');
                    }
                });
        }

        function toggleLoginAlerts() {
            fetch('/api/settings/login-alerts/toggle', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function toggleNotification(type) {
            fetch(`/api/settings/notifications/${type}/toggle`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function toggleAlert(type) {
            fetch(`/api/settings/alerts/${type}/toggle`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function togglePrivacy(setting) {
            fetch(`/api/settings/privacy/${setting}/toggle`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function toggleCompactMode() {
            fetch('/api/settings/compact-mode/toggle', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function toggleReduceAnimations() {
            fetch('/api/settings/reduce-animations/toggle', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        function toggleAccessibility(feature) {
            fetch(`/api/settings/accessibility/${feature}/toggle`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const toggle = event.currentTarget;
                        toggle.classList.toggle('active');
                    }
                });
        }

        // Password change
        function changePassword() {
            new bootstrap.Modal(document.getElementById('changePasswordModal')).show();
        }

        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = {
                currentPassword: formData.get('currentPassword'),
                newPassword: formData.get('newPassword'),
                confirmPassword: formData.get('confirmPassword')
            };

            if (data.newPassword !== data.confirmPassword) {
                showToast('New passwords do not match', 'error');
                return;
            }

            fetch('/api/settings/password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Password updated successfully', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('changePasswordModal')).hide();
                } else {
                    showToast(data.message || 'Failed to update password', 'error');
                }
            });
        });

        // Session management
        function logoutAllDevices() {
            if (confirm('This will log you out from all other devices. Continue?')) {
                fetch('/api/settings/logout-all', { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Logged out from all other devices', 'success');
                        }
                    });
            }
        }

        // API Keys
        function generateApiKey() {
            new bootstrap.Modal(document.getElementById('apiKeyModal')).show();
        }

        document.getElementById('apiKeyForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = {
                name: formData.get('name'),
                permissions: $(this).find('select[name="permissions"]').val(),
                expiration: formData.get('expiration')
            };

            fetch('/api/settings/api-keys', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('API key generated successfully', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('apiKeyModal')).hide();
                    setTimeout(() => window.location.reload(), 1500);
                }
            });
        });

        function copyApiKey(key) {
            navigator.clipboard.writeText(key);
            showToast('API key copied to clipboard', 'success');
        }

        function revokeApiKey(id) {
            if (confirm('Are you sure you want to revoke this API key?')) {
                fetch(`/api/settings/api-keys/${id}`, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('API key revoked', 'success');
                            setTimeout(() => window.location.reload(), 1500);
                        }
                    });
            }
        }

        // Webhooks
        function addWebhook() {
            new bootstrap.Modal(document.getElementById('webhookModal')).show();
        }

        document.getElementById('webhookForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = {
                url: formData.get('url'),
                events: $(this).find('select[name="events"]').val(),
                secret: formData.get('secret')
            };

            fetch('/api/settings/webhooks', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Webhook added successfully', 'success');
                    bootstrap.Modal.getInstance(document.getElementById('webhookModal')).hide();
                    setTimeout(() => window.location.reload(), 1500);
                }
            });
        });

        function testWebhook(id) {
            fetch(`/api/settings/webhooks/${id}/test`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    showToast(data.message, data.success ? 'success' : 'error');
                });
        }

        function editWebhook(id) {
            // Load webhook data and show modal
            console.log('Edit webhook:', id);
        }

        function deleteWebhook(id) {
            if (confirm('Are you sure you want to delete this webhook?')) {
                fetch(`/api/settings/webhooks/${id}`, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Webhook deleted', 'success');
                            setTimeout(() => window.location.reload(), 1500);
                        }
                    });
            }
        }

        // Integrations
        function toggleIntegration(integration) {
            fetch(`/api/settings/integrations/${integration}/toggle`, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    }
                });
        }

        // Backup
        function createBackup() {
            fetch('/api/settings/backup', { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast('Backup created successfully', 'success');
                        setTimeout(() => window.location.reload(), 1500);
                    }
                });
        }

        function restoreBackup(id) {
            if (confirm('This will restore data from backup. Current data will be overwritten. Continue?')) {
                fetch(`/api/settings/backup/${id}/restore`, { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Backup restored successfully', 'success');
                        }
                    });
            }
        }

        function downloadBackup(id) {
            window.location.href = `/api/settings/backup/${id}/download`;
        }

        function deleteBackup(id) {
            if (confirm('Are you sure you want to delete this backup?')) {
                fetch(`/api/settings/backup/${id}`, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Backup deleted', 'success');
                            setTimeout(() => window.location.reload(), 1500);
                        }
                    });
            }
        }

        function scheduleBackup() {
            // Show scheduling modal
            console.log('Schedule backup');
        }

        // Data management
        function downloadMyData() {
            window.location.href = '/api/settings/export-data';
        }

        // Danger zone
        function deactivateAccount() {
            if (confirm('Are you sure you want to deactivate your account? You can reactivate it later by contacting support.')) {
                fetch('/api/settings/deactivate', { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Account deactivated', 'success');
                            setTimeout(() => window.location.href = '/logout', 2000);
                        }
                    });
            }
        }

        function deleteAccount() {
            if (confirm('WARNING: This will permanently delete your account and all associated data. This action cannot be undone. Continue?')) {
                fetch('/api/settings/delete', { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Account deleted', 'success');
                            setTimeout(() => window.location.href = '/', 2000);
                        }
                    });
            }
        }

        // Toast notification
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                    <div>${message}</div>
                </div>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>
</body>
</html>