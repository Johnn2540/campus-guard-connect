                <!-- Appearance Section -->
                <div id="appearance" class="settings-section" style="display: none;">
                    <div class="settings-header">
                        <h3>Appearance</h3>
                        <p>Customize how the application looks</p>
                    </div>

                    <div class="section-title">Theme</div>
                    <div class="theme-options">
                        <div class="theme-option {{#if (eq user.theme "light")}}active{{/if}}" onclick="setTheme('light')">
                            <div class="theme-preview light"></div>
                            <span class="theme-name">Light</span>
                        </div>
                        <div class="theme-option {{#if (eq user.theme "dark")}}active{{/if}}" onclick="setTheme('dark')">
                            <div class="theme-preview dark"></div>
                            <span class="theme-name">Dark</span>
                        </div>
                        <div class="theme-option {{#if (eq user.theme "system")}}active{{/if}}" onclick="setTheme('system')">
                            <div class="theme-preview system"></div>
                            <span class="theme-name">System</span>
                        </div>
                    </div>

                    <div class="section-title mt-4">Compact Mode</div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <h5>Compact Dashboard</h5>
