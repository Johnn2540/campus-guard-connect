                            <div class="toggle-switch {{#if user.notifications.incidentUpdates}}active{{/if}}" onclick="toggleAlert('incidentUpdates')"></div>
                        </div>

                        <div class="setting-item">
                            <div class="setting-info">
                                <h5>Critical Incidents</h5>
                                <p>Immediate notifications for critical incidents</p>
