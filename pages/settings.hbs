                        </div>
                        <div class="toggle-switch {{#if user.compactMode}}active{{/if}}" onclick="toggleCompactMode()"></div>
                    </div>

                    <div class="section-title mt-4">Animations</div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <h5>Reduce Animations</h5>
