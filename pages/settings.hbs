                                <label class="form-label">Country</label>
                                <select class="form-select" name="country">
                                    <option value="KE" {{#if (eq user.country "KE")}}selected{{/if}}>Kenya</option>
                                    <option value="UG" {{#if (eq user.country "UG")}}selected{{/if}}>Uganda</option>
                                    <option value="TZ" {{#if (eq user.country "TZ")}}selected{{/if}}>Tanzania</option>
                                    <option value="US" {{#if (eq user.country "US")}}selected{{/if}}>United States</option>
                                    <option value="GB" {{#if (eq user.country "GB")}}selected{{/if}}>United Kingdom</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Currency</label>
                                <select class="form-select" name="currency">
                                    <option value="KES" {{#if (eq user.currency "KES")}}selected{{/if}}>KES - Kenyan Shilling</option>
                                    <option value="UGX" {{#if (eq user.currency "UGX")}}selected{{/if}}>UGX - Ugandan Shilling</option>
                                    <option value="TZS" {{#if (eq user.currency "TZS")}}selected{{/if}}>TZS - Tanzanian Shilling</option>
                                    <option value="USD" {{#if (eq user.currency "USD")}}selected{{/if}}>USD - US Dollar</option>
                                    <option value="GBP" {{#if (eq user.currency "GBP")}}selected{{/if}}>GBP - British Pound</option>
                                </select>
