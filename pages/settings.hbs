                            <option value="60" {{#if (eq user.sessionTimeout 60)}}selected{{/if}}>1 hour</option>
                            <option value="120" {{#if (eq user.sessionTimeout 120)}}selected{{/if}}>2 hours</option>
                            <option value="240" {{#if (eq user.sessionTimeout 240)}}selected{{/if}}>4 hours</option>
                        </select>
