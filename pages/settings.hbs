                                        <option value="Africa/Nairobi" {{#if (eq user.timezone "Africa/Nairobi")}}selected{{/if}}>Africa/Nairobi (EAT)</option>
                                        <option value="Africa/Lagos" {{#if (eq user.timezone "Africa/Lagos")}}selected{{/if}}>Africa/Lagos (WAT)</option>
                                        <option value="Africa/Johannesburg" {{#if (eq user.timezone "Africa/Johannesburg")}}selected{{/if}}>Africa/Johannesburg (SAST)</option>
                                        <option value="America/New_York" {{#if (eq user.timezone "America/New_York")}}selected{{/if}}>America/New York (EST)</option>
