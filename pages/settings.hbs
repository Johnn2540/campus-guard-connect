                                        <option value="DD/MM/YYYY" {{#if (eq user.dateFormat "DD/MM/YYYY")}}selected{{/if}}>DD/MM/YYYY</option>
                                        <option value="YYYY-MM-DD" {{#if (eq user.dateFormat "YYYY-MM-DD")}}selected{{/if}}>YYYY-MM-DD</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
