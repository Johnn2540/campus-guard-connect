<!-- views/incident.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incident Management - Campus Guard Connect</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
        }

        /* Navbar */
        .navbar {
            background: white;
            padding: 1rem 2rem;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .navbar-brand i {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2rem;
        }

        .user-menu {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .notification-badge {
            position: relative;
            cursor: pointer;
        }

        .notification-badge i {
            font-size: 1.3rem;
            color: #64748b;
            transition: color 0.3s ease;
        }

        .notification-badge:hover i {
            color: #667eea;
        }

        .badge-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: linear-gradient(135deg, #f56565 0%, #c53030 100%);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            background: #f8fafc;
        }

        .user-profile:hover {
            background: #eef2f6;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1rem;
        }

        .user-info {
            display: none;
        }

        @media (min-width: 768px) {
            .user-info {
                display: block;
            }
            
            .user-info h6 {
                font-weight: 700;
                color: #1e293b;
                margin-bottom: 0.2rem;
                font-size: 0.9rem;
            }
            
            .user-info p {
                color: #64748b;
                font-size: 0.8rem;
                margin-bottom: 0;
                text-transform: capitalize;
            }
        }

        /* Main Content */
        .main-content {
            padding: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .page-header h2 {
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.25rem;
            font-size: 2rem;
        }

        .page-header p {
            color: #64748b;
            margin-bottom: 0;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .btn-outline {
            border: 2px solid #e2e8f0;
            background: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            color: #4a5568;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-outline:hover {
            border-color: #667eea;
            color: #667eea;
        }

        /* Stats Cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: height 0.3s ease;
        }

        .stat-card:hover::before {
            height: 100%;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stat-icon i {
            font-size: 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .stat-trend {
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .trend-up {
            color: #48bb78;
        }

        .trend-down {
            color: #f56565;
        }

        /* Filter Bar */
        .filter-bar {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

        .filter-group {
            flex: 1;
            min-width: 150px;
        }

        .filter-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 0.25rem;
            display: block;
        }

        .filter-select, .filter-input {
            width: 100%;
            padding: 0.5rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: white;
        }

        .filter-select:focus, .filter-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            outline: none;
        }

        .filter-actions {
            display: flex;
            gap: 0.5rem;
            align-items: flex-end;
        }

        .btn-filter {
            padding: 0.5rem 1.5rem;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-filter:hover {
            background: #764ba2;
            transform: translateY(-2px);
        }

        .btn-reset {
            padding: 0.5rem 1.5rem;
            background: #e2e8f0;
            color: #4a5568;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-reset:hover {
            background: #cbd5e0;
        }

        /* Incidents Table */
        .table-container {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
        }

        .incidents-table {
            width: 100%;
            border-collapse: collapse;
        }

        .incidents-table th {
            text-align: left;
            padding: 1rem;
            background: #f8fafc;
            font-weight: 700;
            color: #4a5568;
            border-bottom: 2px solid #e2e8f0;
        }

        .incidents-table td {
            padding: 1rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .incidents-table tbody tr {
            transition: all 0.3s ease;
        }

        .incidents-table tbody tr:hover {
            background: #f8fafc;
        }

        .severity-badge {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .severity-critical {
            background: rgba(245, 101, 101, 0.15);
            color: #c53030;
        }

        .severity-high {
            background: rgba(245, 158, 11, 0.15);
            color: #b45309;
        }

        .severity-medium {
            background: rgba(251, 191, 36, 0.15);
            color: #92400e;
        }

        .severity-low {
            background: rgba(72, 187, 120, 0.15);
            color: #276749;
        }

        .status-badge {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-reported {
            background: rgba(102, 126, 234, 0.15);
            color: #434190;
        }

        .status-acknowledged {
            background: rgba(237, 137, 54, 0.15);
            color: #9c4221;
        }

        .status-investigating {
            background: rgba(159, 122, 234, 0.15);
            color: #6b46a1;
        }

        .status-in_progress {
            background: rgba(66, 153, 225, 0.15);
            color: #2c5282;
        }

        .status-resolved {
            background: rgba(72, 187, 120, 0.15);
            color: #276749;
        }

        .status-closed {
            background: rgba(160, 174, 192, 0.15);
            color: #4a5568;
        }

        .action-btns {
            display: flex;
            gap: 0.5rem;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border: none;
            background: transparent;
            border-radius: 8px;
            color: #94a3b8;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .action-btn:hover {
            background: #eef2f6;
            color: #667eea;
        }

        .incident-map {
            height: 300px;
            border-radius: 15px;
            overflow: hidden;
            margin-top: 2rem;
        }

        /* Quick Stats */
        .type-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .type-stat-item {
            text-align: center;
            padding: 1rem;
            background: #f8fafc;
            border-radius: 12px;
        }

        .type-stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #667eea;
        }

        .type-stat-label {
            font-size: 0.8rem;
            color: #64748b;
        }

        /* Loading Spinner */
        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #e2e8f0;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 2rem auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Modal */
        .modal-content {
            border: none;
            border-radius: 20px;
            overflow: hidden;
        }

        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1.5rem;
            border: none;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            padding: 1.5rem;
            border-top: 2px solid #e2e8f0;
        }

        .detail-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 0.25rem;
        }

        .detail-value {
            color: #1e293b;
            margin-bottom: 1rem;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 1.5rem;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -1.5rem;
            top: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #667eea;
            border: 2px solid white;
            box-shadow: 0 0 0 2px #667eea;
        }

        .timeline-item::after {
            content: '';
            position: absolute;
            left: -1rem;
            top: 1rem;
            bottom: 0;
            width: 2px;
            background: #e2e8f0;
        }

        .timeline-item:last-child::after {
            display: none;
        }

        .timeline-time {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-bottom: 0.25rem;
        }

        .timeline-title {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .timeline-description {
            font-size: 0.9rem;
            color: #64748b;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-content {
                padding: 1rem;
            }
            
            .stats-row {
                grid-template-columns: 1fr;
            }
            
            .filter-bar {
                flex-direction: column;
            }
            
            .filter-group {
                width: 100%;
            }
            
            .incidents-table {
                display: block;
                overflow-x: auto;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">
                <i class="fas fa-shield-alt"></i>
                CampusGuard Connect
            </a>
            
            <div class="user-menu">
                <div class="notification-badge">
                    <i class="far fa-bell"></i>
                    <span class="badge-count">{{notificationCount}}</span>
                </div>
                
                <div class="dropdown">
                    <div class="user-profile" data-bs-toggle="dropdown">
                        <div class="user-avatar">
                            {{#if user}}
                                {{#if user.firstName}}
                                    {{user.firstName.[0]}}{{user.lastName.[0]}}
                                {{else}}
                                    {{user.email.[0]}}
                                {{/if}}
                            {{else}}
                                U
                            {{/if}}
                        </div>
                        <div class="user-info">
                            <h6>{{#if user}}{{user.firstName}} {{user.lastName}}{{else}}User{{/if}}</h6>
                            <p>{{#if user}}{{user.role}}{{else}}Guest{{/if}}</p>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/profile"><i class="fas fa-user me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="/settings"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        <li><a class="dropdown-item" href="/help"><i class="fas fa-question-circle me-2"></i>Help</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h2><i class="fas fa-exclamation-triangle me-2" style="color: #667eea;"></i>Incident Management</h2>
                <p>Track, manage, and respond to security incidents across campus</p>
            </div>
            
            <div class="header-actions">
                <button class="btn-primary" data-bs-toggle="modal" data-bs-target="#reportIncidentModal">
                    <i class="fas fa-plus-circle"></i>
                    Report Incident
                </button>
                <button class="btn-outline" onclick="exportIncidents()">
                    <i class="fas fa-download"></i>
                    Export
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <span class="stat-trend trend-up">
                        <i class="fas fa-arrow-up"></i> 12%
                    </span>
                </div>
                <div class="stat-value">{{totalIncidents}}</div>
                <div class="stat-label">Total Incidents</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <span class="stat-trend trend-down">
                        <i class="fas fa-arrow-down"></i> 8%
                    </span>
                </div>
                <div class="stat-value">{{openIncidents}}</div>
                <div class="stat-label">Open Incidents</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <span class="stat-trend trend-up">
                        <i class="fas fa-arrow-up"></i> 15%
                    </span>
                </div>
                <div class="stat-value">{{resolvedToday}}</div>
                <div class="stat-label">Resolved Today</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon">
                        <i class="fas fa-stopwatch"></i>
                    </div>
                </div>
                <div class="stat-value">{{avgResponseTime}}min</div>
                <div class="stat-label">Avg Response Time</div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="filter-group">
                <label>Severity</label>
                <select class="filter-select" id="severityFilter">
                    <option value="">All Severities</option>
                    <option value="critical">Critical</option>
                    <option value="high">High</option>
                    <option value="medium">Medium</option>
                    <option value="low">Low</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Status</label>
                <select class="filter-select" id="statusFilter">
                    <option value="">All Statuses</option>
                    <option value="reported">Reported</option>
                    <option value="acknowledged">Acknowledged</option>
                    <option value="investigating">Investigating</option>
                    <option value="in_progress">In Progress</option>
                    <option value="resolved">Resolved</option>
                    <option value="closed">Closed</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Type</label>
                <select class="filter-select" id="typeFilter">
                    <option value="">All Types</option>
                    <option value="theft">Theft</option>
                    <option value="vandalism">Vandalism</option>
                    <option value="unauthorized_access">Unauthorized Access</option>
                    <option value="fire">Fire</option>
                    <option value="medical_emergency">Medical Emergency</option>
                    <option value="suspicious_activity">Suspicious Activity</option>
                    <option value="accident">Accident</option>
                    <option value="assault">Assault</option>
                    <option value="harassment">Harassment</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Date Range</label>
                <input type="text" class="filter-input" id="dateRange" placeholder="Select date range">
            </div>

            <div class="filter-actions">
                <button class="btn-filter" onclick="applyFilters()">
                    <i class="fas fa-filter me-2"></i>Apply
                </button>
                <button class="btn-reset" onclick="resetFilters()">
                    <i class="fas fa-undo me-2"></i>Reset
                </button>
            </div>
        </div>

        <!-- Incident Type Quick Stats -->
        <div class="type-stats">
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.theft}}</div>
                <div class="type-stat-label">Theft</div>
            </div>
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.vandalism}}</div>
                <div class="type-stat-label">Vandalism</div>
            </div>
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.unauthorized}}</div>
                <div class="type-stat-label">Unauthorized</div>
            </div>
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.medical}}</div>
                <div class="type-stat-label">Medical</div>
            </div>
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.fire}}</div>
                <div class="type-stat-label">Fire</div>
            </div>
            <div class="type-stat-item">
                <div class="type-stat-value">{{typeStats.other}}</div>
                <div class="type-stat-label">Other</div>
            </div>
        </div>

        <!-- Incidents Table -->
        <div class="table-container">
            <table class="incidents-table" id="incidentsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Severity</th>
                        <th>Location</th>
                        <th>Reported By</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each incidents}}
                    <tr>
                        <td>
                            <span class="fw-bold">#{{inc this._id}}</span>
                        </td>
                        <td>
                            <div class="fw-bold">{{this.title}}</div>
                            <small class="text-muted">{{truncate this.description 50}}</small>
                        </td>
                        <td>
                            <span class="badge bg-secondary">{{formatType this.type}}</span>
                        </td>
                        <td>
                            <span class="severity-badge severity-{{this.severity}}">
                                {{formatSeverity this.severity}}
                            </span>
                        </td>
                        <td>
                            <i class="fas fa-map-marker-alt me-1" style="color: #667eea;"></i>
                            {{this.location.name}}
                            {{#if this.location.building}}
                                <br><small>{{this.location.building}} {{this.location.room}}</small>
                            {{/if}}
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="user-avatar-small me-2">
                                    {{#if this.reportedBy}}
                                        {{this.reportedBy.name.[0]}}
                                    {{else}}
                                        U
                                    {{/if}}
                                </div>
                                <div>
                                    <div>{{this.reportedBy.name}}</div>
                                    <small class="text-muted">{{this.reportedBy.role}}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="status-badge status-{{this.status}}">
                                {{formatStatus this.status}}
                            </span>
                        </td>
                        <td>
                            <div>{{formatDate this.createdAt "MMM DD, YYYY"}}</div>
                            <small class="text-muted">{{formatDate this.createdAt "HH:mm"}}</small>
                        </td>
                        <td>
                            <div class="action-btns">
                                <button class="action-btn" onclick="viewIncident('{{this._id}}')" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </button>
                                {{#if (ifNotEquals ../user.role 'student')}}
                                <button class="action-btn" onclick="editIncident('{{this._id}}')" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                {{/if}}
                                {{#if (ifEquals ../user.role 'admin')}}
                                <button class="action-btn" onclick="deleteIncident('{{this._id}}')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                                {{/if}}
                                <button class="action-btn" onclick="assignIncident('{{this._id}}')" title="Assign">
                                    <i class="fas fa-user-plus"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <i class="fas fa-check-circle fa-3x mb-3" style="color: #48bb78;"></i>
                            <h6 style="color: #94a3b8;">No incidents reported</h6>
                            <p class="text-muted">Campus is currently safe and secure</p>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <!-- Incident Map -->
        <div class="incident-map" id="incidentMap"></div>
    </div>

    <!-- Report Incident Modal -->
    <div class="modal fade" id="reportIncidentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Report New Incident
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/incidents/report" method="POST" id="reportIncidentForm" enctype="multipart/form-data">
                    <div class="modal-body">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label">
                                    <i class="fas fa-heading me-2" style="color: #667eea;"></i>
                                    Incident Title
                                </label>
                                <input type="text" class="form-control" name="title" 
                                       placeholder="Brief title describing the incident" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-tag me-2" style="color: #667eea;"></i>
                                    Incident Type
                                </label>
                                <select class="form-select" name="type" required>
                                    <option value="">Select type...</option>
                                    <option value="theft">Theft</option>
                                    <option value="vandalism">Vandalism</option>
                                    <option value="unauthorized_access">Unauthorized Access</option>
                                    <option value="fire">Fire</option>
                                    <option value="medical_emergency">Medical Emergency</option>
                                    <option value="suspicious_activity">Suspicious Activity</option>
                                    <option value="accident">Accident</option>
                                    <option value="assault">Assault</option>
                                    <option value="harassment">Harassment</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-exclamation-circle me-2" style="color: #667eea;"></i>
                                    Severity
                                </label>
                                <select class="form-select" name="severity" required>
                                    <option value="">Select severity...</option>
                                    <option value="low">Low - Minor issue</option>
                                    <option value="medium">Medium - Requires attention</option>
                                    <option value="high">High - Urgent response needed</option>
                                    <option value="critical">Critical - Immediate action required</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    <i class="fas fa-align-left me-2" style="color: #667eea;"></i>
                                    Description
                                </label>
                                <textarea class="form-control" name="description" rows="4" 
                                          placeholder="Provide detailed description of what happened" required></textarea>
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">
                                    <i class="fas fa-map-marker-alt me-2" style="color: #667eea;"></i>
                                    Location
                                </label>
                                <input type="text" class="form-control" name="location" 
                                       placeholder="e.g., Main Gate, Library, Hostel Block A" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">
                                    <i class="fas fa-building me-2" style="color: #667eea;"></i>
                                    Building (Optional)
                                </label>
                                <input type="text" class="form-control" name="building" 
                                       placeholder="Building name">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    <i class="fas fa-layer-group me-2" style="color: #667eea;"></i>
                                    Floor
                                </label>
                                <input type="text" class="form-control" name="floor" 
                                       placeholder="e.g., 2nd">
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    <i class="fas fa-door-open me-2" style="color: #667eea;"></i>
                                    Room
                                </label>
                                <input type="text" class="form-control" name="room" 
                                       placeholder="Room number">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    <i class="fas fa-camera me-2" style="color: #667eea;"></i>
                                    Media Evidence
                                </label>
                                <input type="file" class="form-control" name="media" multiple 
                                       accept="image/*,video/*">
                                <small class="text-muted">Upload photos or videos (max 10MB each)</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    <i class="fas fa-users me-2" style="color: #667eea;"></i>
                                    Witnesses (Optional)
                                </label>
                                <div id="witnesses">
                                    <div class="row g-3 mb-2">
                                        <div class="col-md-4">
                                            <input type="text" class="form-control" name="witnessName[]" 
                                                   placeholder="Witness name">
                                        </div>
                                        <div class="col-md-4">
                                            <input type="tel" class="form-control" name="witnessPhone[]" 
                                                   placeholder="Phone number">
                                        </div>
                                        <div class="col-md-4">
                                            <button type="button" class="btn-outline w-100" onclick="addWitness()">
                                                <i class="fas fa-plus me-2"></i>Add Witness
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-outline" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary" id="submitIncidentBtn">
                            <i class="fas fa-paper-plane me-2"></i>Report Incident
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- View Incident Modal -->
    <div class="modal fade" id="viewIncidentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-info-circle me-2"></i>
                        Incident Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="incidentDetails">
                    <!-- Incident details will be loaded here dynamically -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-primary" onclick="updateIncidentStatus()">
                        <i class="fas fa-sync-alt me-2"></i>Update Status
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        // Initialize DataTable
        $(document).ready(function() {
            $('#incidentsTable').DataTable({
                pageLength: 10,
                order: [[7, 'desc']],
                language: {
                    search: '<i class="fas fa-search"></i>',
                    searchPlaceholder: 'Search incidents...'
                }
            });
        });

        // Initialize Map
        document.addEventListener('DOMContentLoaded', function() {
            const mapElement = document.getElementById('incidentMap');
            if (mapElement) {
                const map = L.map('incidentMap').setView([-1.2864, 36.8172], 15);
                
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(map);
                
                // Add incident markers from data
                const incidents = {{{json incidents}}};
                incidents.forEach(incident => {
                    if (incident.location && incident.location.coordinates) {
                        const marker = L.marker(incident.location.coordinates).addTo(map);
                        const severityColor = {
                            'critical': '#f56565',
                            'high': '#ed8936',
                            'medium': '#ecc94b',
                            'low': '#48bb78'
                        }[incident.severity] || '#667eea';
                        
                        marker.bindPopup(`
                            <b>${incident.title}</b><br>
                            Severity: ${incident.severity}<br>
                            Status: ${incident.status}<br>
                            <button onclick="viewIncident('${incident._id}')">View Details</button>
                        `);
                    }
                });
            }
        });

        // Form Submission with Loading State
        document.getElementById('reportIncidentForm')?.addEventListener('submit', function(e) {
            const btn = document.getElementById('submitIncidentBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span> Reporting...';
        });

        // Witness Management
        function addWitness() {
            const witnesses = document.getElementById('witnesses');
            const newWitness = document.createElement('div');
            newWitness.className = 'row g-3 mb-2';
            newWitness.innerHTML = `
                <div class="col-md-4">
                    <input type="text" class="form-control" name="witnessName[]" placeholder="Witness name">
                </div>
                <div class="col-md-4">
                    <input type="tel" class="form-control" name="witnessPhone[]" placeholder="Phone number">
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn-outline w-100" onclick="this.closest('.row').remove()">
                        <i class="fas fa-times me-2"></i>Remove
                    </button>
                </div>
            `;
            witnesses.appendChild(newWitness);
        }

        // Filter Functions
        function applyFilters() {
            const severity = document.getElementById('severityFilter').value;
            const status = document.getElementById('statusFilter').value;
            const type = document.getElementById('typeFilter').value;
            
            // Apply to DataTable
            const table = $('#incidentsTable').DataTable();
            
            // Custom filtering
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    const rowSeverity = data[3].toLowerCase();
                    const rowStatus = data[6].toLowerCase();
                    const rowType = data[2].toLowerCase();
                    
                    if (severity && !rowSeverity.includes(severity)) return false;
                    if (status && !rowStatus.includes(status)) return false;
                    if (type && !rowType.includes(type)) return false;
                    
                    return true;
                }
            );
            
            table.draw();
        }

        function resetFilters() {
            document.getElementById('severityFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('typeFilter').value = '';
            
            const table = $('#incidentsTable').DataTable();
            $.fn.dataTable.ext.search.pop();
            table.search('').columns().search('').draw();
        }

        // Incident Actions
        function viewIncident(id) {
            fetch(`/api/incidents/${id}`)
                .then(response => response.json())
                .then(data => {
                    const modal = new bootstrap.Modal(document.getElementById('viewIncidentModal'));
                    document.getElementById('incidentDetails').innerHTML = `
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-label">Title</div>
                                <div class="detail-value">${data.title}</div>
                                
                                <div class="detail-label">Type</div>
                                <div class="detail-value">${data.type}</div>
                                
                                <div class="detail-label">Severity</div>
                                <div class="detail-value">
                                    <span class="severity-badge severity-${data.severity}">${data.severity}</span>
                                </div>
                                
                                <div class="detail-label">Status</div>
                                <div class="detail-value">
                                    <span class="status-badge status-${data.status}">${data.status}</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-label">Location</div>
                                <div class="detail-value">${data.location.name}</div>
                                
                                <div class="detail-label">Reported By</div>
                                <div class="detail-value">${data.reportedBy.name}</div>
                                
                                <div class="detail-label">Reported On</div>
                                <div class="detail-value">${new Date(data.createdAt).toLocaleString()}</div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="detail-label">Description</div>
                                <div class="detail-value">${data.description}</div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="detail-label">Timeline</div>
                                <div class="timeline">
                                    ${data.timeline.map(t => `
                                        <div class="timeline-item">
                                            <div class="timeline-time">${new Date(t.timestamp).toLocaleString()}</div>
                                            <div class="timeline-title">${t.status}</div>
                                            <div class="timeline-description">${t.comment || ''}</div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        </div>
                    `;
                    modal.show();
                });
        }

        function editIncident(id) {
            window.location.href = `/incidents/${id}/edit`;
        }

        function deleteIncident(id) {
            if (confirm('Are you sure you want to delete this incident?')) {
                fetch(`/incidents/${id}`, {
                    method: 'DELETE'
                }).then(response => {
                    if (response.ok) {
                        window.location.reload();
                    }
                });
            }
        }

        function assignIncident(id) {
            const guard = prompt('Enter guard ID to assign:');
            if (guard) {
                fetch(`/incidents/${id}/assign`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ guardId: guard })
                }).then(response => {
                    if (response.ok) {
                        alert('Incident assigned successfully');
                        window.location.reload();
                    }
                });
            }
        }

        function exportIncidents() {
            const format = prompt('Export format (pdf/excel/csv):', 'excel');
            if (format) {
                window.location.href = `/incidents/export?format=${format}`;
            }
        }

        // Auto-refresh every 30 seconds
        setInterval(() => {
            fetch('/api/incidents/recent')
                .then(response => response.json())
                .then(data => {
                    // Update table without page reload
                    const table = $('#incidentsTable').DataTable();
                    table.clear();
                    table.rows.add(data);
                    table.draw();
                });
        }, 30000);

        // Helper Functions
        function formatType(type) {
            return type.split('_').map(word => 
                word.charAt(0).toUpperCase() + word.slice(1)
            ).join(' ');
        }

        function formatSeverity(severity) {
            return severity.charAt(0).toUpperCase() + severity.slice(1);
        }

        function formatStatus(status) {
            return status.split('_').map(word => 
                word.charAt(0).toUpperCase() + word.slice(1)
            ).join(' ');
        }
    </script>
</body>
</html>